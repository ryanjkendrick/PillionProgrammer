<Project>
  <!-- Central package management: every package version used in the repository is pinned here. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!--
    Visual Studio SDK.
    Pinned to the 17.14 line (the newest 17.14.x on nuget.org) rather than 18.x so that a single VSIX
    built against these reference assemblies loads in both Visual Studio 2022 17.14 and Visual Studio 2026 (18.x).
    Moving to 18.x packages would drop 17.14 support.
  -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.VisualStudio.SDK" Version="17.14.40265" />
    <PackageVersion Include="Microsoft.VSSDK.BuildTools" Version="17.14.2142" />
  </ItemGroup>

  <!--
    RPC stack.
    StreamJsonRpc is pinned to exactly the version that Microsoft.VisualStudio.SDK 17.14.40265 depends on. The VSIX
    runs inside devenv.exe, which ships (and binds to) its own copies of these assemblies, so the VSIX never carries
    its own copy (ExcludeAssets="runtime") and compiles against the SDK's transitive versions (MessagePack 2.5.192).
    MessagePack is pinned here to the latest patched 2.5.x release: central versions only apply to direct references,
    which are the host and the tests (the host deserialises pipe traffic in its own process), while the VSIX keeps the
    transitive 2.5.192 from the SDK graph. Both are 2.5.x, so the wire format is identical. Decision 2026-10-08.
    Microsoft.Bcl.AsyncInterfaces and System.Threading.Tasks.Extensions are referenced by Pillion.Contracts
    (compiled into the VSIX), so they are also pinned to the versions in the same 17.14 dependency graph.
  -->
  <ItemGroup>
    <PackageVersion Include="StreamJsonRpc" Version="2.22.11" />
    <PackageVersion Include="MessagePack" Version="2.5.307" />
    <PackageVersion Include="MessagePack.Annotations" Version="2.5.307" />
    <PackageVersion Include="Microsoft.Bcl.AsyncInterfaces" Version="9.0.0" />
    <PackageVersion Include="System.Threading.Tasks.Extensions" Version="4.6.0" />
    <!--
      Also the exact version in the Microsoft.VisualStudio.SDK 17.14.40265 graph. Pillion.VisualStudio.Core compiles
      against it and StreamJsonRpc with ExcludeAssets="runtime" (devenv.exe supplies both); the VSIX tests reference
      them normally because they run outside Visual Studio.
    -->
    <PackageVersion Include="Microsoft.VisualStudio.Threading" Version="17.14.15" />
    <!--
      The version StreamJsonRpc 2.22.11 depends on in the same graph. Pillion.VisualStudio.Core uses it compile-only to
      read and write the JSON that ISettingsService exchanges; devenv.exe supplies Newtonsoft.Json at run time.
    -->
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <!--
    Roslyn, compile-time only, for the VSIX's enclosing-declaration lookup (ghost-text autocomplete). Visual Studio ships
    and binds its own Roslyn (4.14 in 17.14, 5.x in 18.x, with binding redirects), so the VSIX references it with
    ExcludeAssets="runtime" and never carries a copy. Pinned to an older 4.x so the API surface used is in every
    supported Visual Studio.
  -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.CodeAnalysis.Workspaces.Common" Version="4.8.0" />
  </ItemGroup>

  <!--
    Chat window Markdown (design section 5): Markdig parses each assistant reply into blocks that the VSIX renders as WPF
    elements. Licence checked on 2026-10-09: BSD-2-Clause (the package's licenseExpression and its license.txt), not
    MIT, but a permissive licence compatible with this project's MIT licence; its notice ships in the VSIX as
    THIRD-PARTY-NOTICES.txt. 1.4.0 is the newest stable release (2026-09-20). Pillion.VisualStudio.Core references it
    normally, so Markdig.dll is packaged in the VSIX. On .NET Framework it depends on System.Memory 4.6.3 (assembly
    4.0.5.0), which Visual Studio 2022 17.14 and 2026 both ship and redirect to, so Core references System.Memory
    compile-only and the VSIX does not carry a copy.
  -->
  <ItemGroup>
    <PackageVersion Include="Markdig" Version="1.4.0" />
    <PackageVersion Include="System.Memory" Version="4.6.3" />
  </ItemGroup>

  <!-- Host. The abstractions packages are pinned to the same version as the hosting package that depends on them. -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
  </ItemGroup>

  <!--
    Model Gateway. Microsoft.Extensions.AI.Abstractions supplies IChatClient, ChatMessage and ChatResponseUpdate; only
    the abstractions are referenced (adapters are Pillion's own). Pinned to the newest stable 10.x release; on net10.0
    it has no dependencies beyond the shared framework.
  -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.Extensions.AI.Abstractions" Version="10.10.1" />
  </ItemGroup>

  <!--
    Token counting (design section 7). Microsoft.ML.Tokenizers 2.0.0 is the newest stable release (November 2025; the
    3.0 line is still in preview). The two data packages carry the tiktoken rank files for o200k_base and cl100k_base
    and are versioned with it; they are loaded lazily, only when a model of those families is counted.
  -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.ML.Tokenizers" Version="2.0.0" />
    <PackageVersion Include="Microsoft.ML.Tokenizers.Data.O200kBase" Version="2.0.0" />
    <PackageVersion Include="Microsoft.ML.Tokenizers.Data.Cl100kBase" Version="2.0.0" />
    <!--
      The data packages target netstandard2.0 only and so pull Microsoft.Bcl.Memory 9.0.4, which has a high severity
      advisory (GHSA-73j8-2gch-69rq). The Model Gateway references it directly at the patched 10.0.12, the same servicing
      release as the Microsoft.Extensions packages above, so the vulnerable version never reaches the host.
    -->
    <PackageVersion Include="Microsoft.Bcl.Memory" Version="10.0.12" />
  </ItemGroup>

  <!--
    Roslyn's parsers, used by Pillion Host for syntax validation only (work item 1.8, design section 8): an inline edit
    to a C# or VB file is parsed with CSharpSyntaxTree / VisualBasicSyntaxTree to count syntax errors before the VSIX
    previews it. Nothing is compiled and no workspace is loaded. 5.0.0 is the newest stable release in the local
    package cache; the host is not loaded into devenv.exe, so it does not have to match Visual Studio's own Roslyn.
  -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.VisualBasic" Version="5.0.0" />
  </ItemGroup>

  <!-- Tests. -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
  </ItemGroup>

  <!--
    Visual Studio integration tests: the [IdeFact] framework used by Roslyn and the VS SDK samples. It is not on
    nuget.org; Microsoft publishes it only to the public Azure Artifacts feed "vssdk" (see nuget.config), and there is no
    stable version. No single version drives both Visual Studio versions we support, so there are two pins:

    - Visual Studio 2026 (18.x), tests/Pillion.VisualStudio.IntegrationTests: 5.3.0-2.26228.15, the last 5.3 build
      from dotnet/roslyn (where the framework moved; microsoft/vs-extension-testing was archived in August 2026). It
      installs its in-IDE test service with Visual Studio's own VSIXInstaller.exe. That service's manifest targets
      [18.0,19.0), so VSIXInstaller refuses it on 17.x (exit code 2003, NoApplicableSKUsException). Built against
      Microsoft.VisualStudio.Interop 18.0 (see the App.config redirect in that project); its other dependencies match
      the 17.14 SDK graph, unlike the newer 5.10 and 5.13 builds (System.Collections.Immutable 10.0).
    - Visual Studio 2022 (17.14), tests/Pillion.VisualStudio.IntegrationTests.VS2022 (same sources):
      0.1.800-beta, the last release of microsoft/vs-extension-testing. Its own installer for 18.x looks for
      Microsoft.VisualStudio.ExtensionManager.Implementation 17.0 where 18.10 no longer has it, so it cannot drive 18.x
      ("Could not load file or assembly 'Microsoft.VisualStudio.ExtensionManager.Implementation, Version=17.0.0.0'").

    Bump each together with its SourceGenerator, and only after running the integration tests on that version.
  -->
  <PropertyGroup>
    <PillionIdeTestFrameworkVS2022Version>0.1.800-beta</PillionIdeTestFrameworkVS2022Version>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Microsoft.VisualStudio.Extensibility.Testing.Xunit" Version="5.3.0-2.26228.15" />
    <PackageVersion Include="Microsoft.VisualStudio.Extensibility.Testing.SourceGenerator" Version="5.3.0-2.26228.15" />
  </ItemGroup>
</Project>