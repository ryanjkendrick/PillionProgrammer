<Project>
  <!-- Central package management: every package version used in the repository is pinned here. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!--
    Visual Studio SDK.
    Pinned to the 17.14 line (the newest 17.14.x on nuget.org) rather than 18.x so that a single VSIX
    built against these reference assemblies loads in both Visual Studio 2022 17.14 and Visual Studio 2026 (18.x).
    Moving to 18.x packages would drop 17.14 support.
  -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.VisualStudio.SDK" Version="17.14.40265" />
    <PackageVersion Include="Microsoft.VSSDK.BuildTools" Version="17.14.2142" />
  </ItemGroup>

  <!--
    RPC stack.
    StreamJsonRpc and MessagePack are pinned to exactly the versions that Microsoft.VisualStudio.SDK 17.14.40265
    depends on. The VSIX runs inside devenv.exe, which ships (and binds to) its own copies of these assemblies;
    compiling against newer versions would risk MissingMethodException or type-load failures at run time.
    The host and tests use the same versions for now so both ends of the pipe speak the same wire format.
    Microsoft.Bcl.AsyncInterfaces and System.Threading.Tasks.Extensions are referenced by Pillion.Contracts
    (compiled into the VSIX), so they are also pinned to the versions in the same 17.14 dependency graph.
  -->
  <ItemGroup>
    <PackageVersion Include="StreamJsonRpc" Version="2.22.11" />
    <PackageVersion Include="MessagePack" Version="2.5.192" />
    <PackageVersion Include="MessagePack.Annotations" Version="2.5.192" />
    <PackageVersion Include="Microsoft.Bcl.AsyncInterfaces" Version="9.0.0" />
    <PackageVersion Include="System.Threading.Tasks.Extensions" Version="4.6.0" />
  </ItemGroup>

  <!-- Host. -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
  </ItemGroup>

  <!-- Tests. -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
  </ItemGroup>
</Project>
