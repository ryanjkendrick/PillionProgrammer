<UserControl x:Class="Pillion.VisualStudio.ToolWindows.IndexToolWindowControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:ClassModifier="internal"
             xmlns:core="clr-namespace:Pillion.VisualStudio.Core;assembly=Pillion.VisualStudio.Core"
             xmlns:vsshell="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0"
             xmlns:platformui="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
             platformui:ThemedDialogStyleLoader.UseDefaultThemedDialogStyles="True"
             Background="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBackgroundKey}}"
             Foreground="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}"
             FontFamily="{DynamicResource {x:Static vsshell:VsFonts.EnvironmentFontFamilyKey}}"
             FontSize="{DynamicResource {x:Static vsshell:VsFonts.EnvironmentFontSizeKey}}"
             AutomationProperties.Name="{x:Static core:IndexStrings.WindowName}">

    <!--
      The Pillion Index window (work item 2.15; design sections 5, 7, 10, 13 and 15). Every colour comes from a Visual Studio
      theme key (VsBrushes), so the window follows the light, dark, blue and high-contrast themes; state is never shown by
      colour alone: the phase, the pause reason, the secret-bearing marker (a shield beside the words "Secret-bearing file")
      and a stale index (the words "Root is gone") all have text. Everything is reachable with the keyboard (Tab, arrow keys in
      the lists, access keys on the buttons and tabs) and every control has an automation name. Updates are applied by the
      view model in place, at most twice a second.
    -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="VisibleWhenTrue" />

        <Style x:Key="SecondaryText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:VsBrushes.GrayTextKey}}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource SecondaryText}">
            <Setter Property="Margin" Value="0,1,10,1" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>

        <Style x:Key="FieldValue" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,1,0,1" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBorderKey}}" />
            <Setter Property="Padding" Value="8,6,8,6" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Focusable" Value="True" />
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static vsshell:VsBrushes.HighlightKey}}" />
                    <Setter Property="BorderThickness" Value="2" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Hidden unless the bound text is not empty. -->
        <Style x:Key="ShownWhenBound" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- The shield that marks a secret-bearing file. Drawn, so it takes the text colour in every theme. -->
        <DataTemplate x:Key="ShieldCell" DataType="{x:Type core:ExcludedFileRowViewModel}">
            <Viewbox Width="14" Height="14" HorizontalAlignment="Center"
                     Visibility="{Binding IsSecretBearing, Converter={StaticResource VisibleWhenTrue}}"
                     AutomationProperties.Name="{x:Static core:IndexStrings.ShieldName}">
                <Path Data="M 8,0.5 L 15,3 L 15,8 C 15,12 12,14.5 8,15.5 C 4,14.5 1,12 1,8 L 1,3 Z"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListViewItem}}"
                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListViewItem}}"
                      StrokeThickness="1" />
            </Viewbox>
        </DataTemplate>

        <!-- The tab strip and its content, drawn with theme keys only: the default TabControl chrome ignores Visual Studio's themes. -->
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Header" Padding="10,4,10,4" Margin="0,0,2,0" BorderThickness="1,1,1,0"
                                BorderBrush="Transparent" Background="Transparent">
                            <ContentPresenter x:Name="HeaderText" ContentSource="Header" RecognizesAccessKey="True" TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Header" Property="BorderBrush" Value="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBorderKey}}" />
                                <Setter TargetName="Header" Property="Background" Value="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBackgroundKey}}" />
                                <Setter TargetName="HeaderText" Property="TextElement.FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Header" Property="BorderBrush" Value="{DynamicResource {x:Static vsshell:VsBrushes.HighlightKey}}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabControl">
            <Setter Property="Background" Value="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBackgroundKey}}" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <DockPanel>
                            <TabPanel DockPanel.Dock="Top" IsItemsHost="True" />
                            <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBorderKey}}"
                                    Background="{TemplateBinding Background}">
                                <!-- The part name lets the TabControl's automation peer reach the tab's content (screen readers). -->
                                <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" />
                            </Border>
                        </DockPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <CollectionViewSource x:Key="ExcludedView" Source="{Binding Excluded.Items}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="GroupName" />
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
    </UserControl.Resources>

    <DockPanel Margin="6" LastChildFill="True">

        <!-- Shown instead of the index while the indexWindow feature flag is off (settings or repository policy). -->
        <TextBlock DockPanel.Dock="Top"
                   Text="{Binding DisabledMessage}"
                   Style="{StaticResource ShownWhenBound}"
                   FontWeight="SemiBold"
                   Margin="0,0,0,6"
                   AutomationProperties.Name="{Binding DisabledMessage}"
                   AutomationProperties.LiveSetting="Polite" />

        <Grid>
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsWindowDisabled}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Status header: phase, progress, estimate, pause reason, last error, totals; Pause, Resume and Refresh. -->
            <StackPanel Grid.Row="0" Margin="0,0,0,8" AutomationProperties.Name="{x:Static core:IndexStrings.HeaderName}">
                <TextBlock Text="{Binding HostMessage}" Style="{StaticResource ShownWhenBound}" FontWeight="SemiBold" Margin="0,0,0,4"
                           AutomationProperties.Name="{Binding HostMessage}" AutomationProperties.LiveSetting="Polite" />
                <TextBlock Text="{Binding LoadMessage}" Style="{StaticResource ShownWhenBound}" Margin="0,0,0,4"
                           AutomationProperties.Name="{Binding LoadMessage}" AutomationProperties.LiveSetting="Polite" />

                <!-- Announced by screen readers when the phase changes (not on every progress tick). -->
                <TextBlock Text="{Binding PhaseText}" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap"
                           Focusable="True"
                           AutomationProperties.Name="{Binding SummaryText}"
                           AutomationProperties.LiveSetting="Polite" />
                <TextBlock Text="{Binding PauseReasonText}" Style="{StaticResource ShownWhenBound}" Margin="0,2,0,0"
                           AutomationProperties.LiveSetting="Polite" />
                <ProgressBar Minimum="0" Maximum="100" Height="8" Margin="0,6,0,2"
                             Value="{Binding ProgressPercent, Mode=OneWay}"
                             IsIndeterminate="{Binding IsProgressIndeterminate, Mode=OneWay}"
                             Foreground="{DynamicResource {x:Static vsshell:VsBrushes.HighlightKey}}"
                             Background="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBorderKey}}"
                             BorderBrush="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBorderKey}}"
                             Visibility="{Binding IsProgressVisible, Converter={StaticResource VisibleWhenTrue}}"
                             AutomationProperties.Name="{x:Static core:IndexStrings.ProgressName}" />
                <TextBlock Text="{Binding ProgressText}" Style="{StaticResource ShownWhenBound}" />
                <TextBlock Text="{Binding RemainingText}" Style="{StaticResource ShownWhenBound}" Foreground="{DynamicResource {x:Static vsshell:VsBrushes.GrayTextKey}}" />
                <TextBlock Style="{StaticResource ShownWhenBound}" Margin="0,2,0,0" FontWeight="SemiBold"
                           Text="{Binding LastError, StringFormat={x:Static core:IndexStrings.LastErrorFormat}}"
                           Visibility="{Binding HasLastError, Converter={StaticResource VisibleWhenTrue}}"
                           AutomationProperties.LiveSetting="Polite" />
                <TextBlock Text="{Binding TotalsText}" Style="{StaticResource ShownWhenBound}" Margin="0,4,0,0" />
                <TextBlock Text="{Binding LastUpdatedText}" Style="{StaticResource ShownWhenBound}" Foreground="{DynamicResource {x:Static vsshell:VsBrushes.GrayTextKey}}" />

                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="{x:Static core:IndexStrings.PauseButton}" Command="{Binding PauseCommand}" MinWidth="75"
                            ToolTip="{x:Static core:IndexStrings.PauseToolTip}"
                            AutomationProperties.Name="{x:Static core:IndexStrings.PauseName}" />
                    <Button Content="{x:Static core:IndexStrings.ResumeButton}" Command="{Binding ResumeCommand}" MinWidth="75" Margin="6,0,0,0"
                            ToolTip="{x:Static core:IndexStrings.ResumeToolTip}"
                            AutomationProperties.Name="{x:Static core:IndexStrings.ResumeName}" />
                    <Button Content="{x:Static core:IndexStrings.RefreshButton}" Command="{Binding RefreshCommand}" MinWidth="75" Margin="6,0,0,0"
                            ToolTip="{x:Static core:IndexStrings.RefreshToolTip}"
                            AutomationProperties.Name="{x:Static core:IndexStrings.RefreshName}" />
                </StackPanel>
            </StackPanel>

            <TabControl Grid.Row="1" KeyboardNavigation.TabNavigation="Local">

                <!-- Roots: one card per repository root, with Rebuild and Delete. -->
                <TabItem Header="{x:Static core:IndexStrings.TabRoots}" AutomationProperties.Name="{x:Static core:IndexStrings.TabRootsName}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False" Padding="0,8,0,0">
                        <StackPanel>
                            <TextBlock Text="{Binding NoRootsText}" Style="{StaticResource ShownWhenBound}" Margin="0,0,0,8" />
                            <ItemsControl ItemsSource="{Binding Roots}" Focusable="False" KeyboardNavigation.TabNavigation="Continue">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type core:IndexRootRowViewModel}">
                                        <Border Style="{StaticResource Card}" AutomationProperties.Name="{Binding AutomationName}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding RootPath}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,4" />
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Static core:IndexStrings.RoleLabel}" Style="{StaticResource FieldLabel}" />
                                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding RoleText}" Style="{StaticResource FieldValue}" />
                                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{x:Static core:IndexStrings.FilesLabel}" Style="{StaticResource FieldLabel}" />
                                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding FilesText}" Style="{StaticResource FieldValue}" />
                                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{x:Static core:IndexStrings.ChunksLabel}" Style="{StaticResource FieldLabel}" />
                                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ChunksText}" Style="{StaticResource FieldValue}" />
                                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="{x:Static core:IndexStrings.DiskLabel}" Style="{StaticResource FieldLabel}" />
                                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding DiskText}" Style="{StaticResource FieldValue}" />
                                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="{x:Static core:IndexStrings.ModelLabel}" Style="{StaticResource FieldLabel}" />
                                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding ModelText}" Style="{StaticResource FieldValue}" />
                                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="{x:Static core:IndexStrings.LastSweepLabel}" Style="{StaticResource FieldLabel}" />
                                                    <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding LastSweepText}" Style="{StaticResource FieldValue}" />
                                                    <TextBlock Grid.Row="6" Grid.Column="0" Text="{x:Static core:IndexStrings.ExcludedLabel}" Style="{StaticResource FieldLabel}" />
                                                    <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding ExcludedText}" Style="{StaticResource FieldValue}" />
                                                </Grid>
                                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                    <Button Content="{x:Static core:IndexStrings.RebuildButton}" Command="{Binding RebuildCommand}" MinWidth="75"
                                                            ToolTip="{x:Static core:IndexStrings.RebuildToolTip}"
                                                            AutomationProperties.Name="{Binding RebuildName}" />
                                                    <Button Content="{x:Static core:IndexStrings.DeleteButton}" Command="{Binding DeleteCommand}" MinWidth="75" Margin="6,0,0,0"
                                                            ToolTip="{x:Static core:IndexStrings.DeleteToolTip}"
                                                            AutomationProperties.Name="{Binding DeleteName}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Excluded files: path and rule, secret-bearing ones grouped first and marked with a shield, paged. -->
                <TabItem Header="{x:Static core:IndexStrings.TabExcluded}" AutomationProperties.Name="{x:Static core:IndexStrings.TabExcludedName}">
                    <DockPanel Margin="0,8,0,0" DataContext="{Binding Excluded}">
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Label Grid.Row="0" Grid.Column="0" Content="{x:Static core:IndexStrings.ExcludedRootLabel}" Target="{Binding ElementName=RootPicker}" Padding="0,0,6,0" VerticalAlignment="Center" />
                            <ComboBox x:Name="RootPicker" Grid.Row="0" Grid.Column="1"
                                      ItemsSource="{Binding DataContext.Roots, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                      SelectedItem="{Binding SelectedRoot}"
                                      DisplayMemberPath="RootPath"
                                      AutomationProperties.Name="{x:Static core:IndexStrings.ExcludedRootName}" />
                            <CheckBox Grid.Row="1" Grid.Column="1" Margin="0,6,0,0"
                                      Content="{x:Static core:IndexStrings.SecretOnlyCheck}"
                                      IsChecked="{Binding SecretOnly}"
                                      AutomationProperties.Name="{x:Static core:IndexStrings.SecretOnlyName}" />
                        </Grid>

                        <StackPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                            <TextBlock Text="{Binding PageText}" Margin="0,0,0,4"
                                       AutomationProperties.LiveSetting="Polite" />
                            <TextBlock Text="{Binding Message}" Style="{StaticResource ShownWhenBound}" Margin="0,0,0,4"
                                       AutomationProperties.LiveSetting="Polite" />
                            <WrapPanel>
                                <Button Content="{x:Static core:IndexStrings.PreviousPageButton}" Command="{Binding PreviousPageCommand}" MinWidth="75" Margin="0,0,6,4"
                                        AutomationProperties.Name="{x:Static core:IndexStrings.PreviousPageName}" />
                                <Button Content="{x:Static core:IndexStrings.NextPageButton}" Command="{Binding NextPageCommand}" MinWidth="75" Margin="0,0,6,4"
                                        AutomationProperties.Name="{x:Static core:IndexStrings.NextPageName}" />
                                <Button Content="{x:Static core:IndexStrings.CopyPathButton}" Command="{Binding CopyPathCommand}" MinWidth="75" Margin="0,0,6,4"
                                        AutomationProperties.Name="{x:Static core:IndexStrings.CopyPathName}" />
                                <Button Content="{x:Static core:IndexStrings.OpenPillionIgnoreButton}" Command="{Binding OpenPillionIgnoreCommand}" Margin="0,0,0,4"
                                        ToolTip="{x:Static core:IndexStrings.OpenPillionIgnoreToolTip}"
                                        AutomationProperties.Name="{x:Static core:IndexStrings.OpenPillionIgnoreName}" />
                            </WrapPanel>
                        </StackPanel>

                        <ListView x:Name="ExcludedList"
                                  ItemsSource="{Binding Source={StaticResource ExcludedView}}"
                                  SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                                  SelectionMode="Single"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  AutomationProperties.Name="{x:Static core:IndexStrings.ExcludedListName}">
                            <ListView.InputBindings>
                                <KeyBinding Key="C" Modifiers="Control" Command="{Binding CopyPathCommand}" />
                            </ListView.InputBindings>
                            <ListView.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="{x:Static core:IndexStrings.CopyPathButton}" Command="{Binding PlacementTarget.DataContext.CopyPathCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" InputGestureText="Ctrl+C" />
                                </ContextMenu>
                            </ListView.ContextMenu>
                            <ListView.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock FontWeight="SemiBold" Margin="0,6,0,2">
                                                <Run Text="{Binding Name, Mode=OneWay}" /><Run Text=" (" /><Run Text="{Binding ItemCount, Mode=OneWay}" /><Run Text=")" />
                                            </TextBlock>
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ListView.GroupStyle>
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Width="40" CellTemplate="{StaticResource ShieldCell}">
                                        <GridViewColumn.Header>
                                            <TextBlock Text="{x:Static core:IndexStrings.ExcludedColumnShield}" />
                                        </GridViewColumn.Header>
                                    </GridViewColumn>
                                    <GridViewColumn Header="{x:Static core:IndexStrings.ExcludedColumnPath}" DisplayMemberBinding="{Binding RelativePath}" Width="220" />
                                    <GridViewColumn Header="{x:Static core:IndexStrings.ExcludedColumnKind}" DisplayMemberBinding="{Binding KindText}" Width="120" />
                                    <GridViewColumn Header="{x:Static core:IndexStrings.ExcludedColumnReason}" DisplayMemberBinding="{Binding ReasonText}" Width="150" />
                                    <GridViewColumn Header="{x:Static core:IndexStrings.ExcludedColumnDetails}" DisplayMemberBinding="{Binding Description}" Width="320" />
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </DockPanel>
                </TabItem>

                <!-- Indexes: every index folder on this machine, with Delete. -->
                <TabItem Header="{x:Static core:IndexStrings.TabIndexes}" AutomationProperties.Name="{x:Static core:IndexStrings.TabIndexesName}">
                    <DockPanel Margin="0,8,0,0" DataContext="{Binding Folders}">
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                            <TextBlock Text="{Binding Summary}" Margin="0,0,0,4" AutomationProperties.LiveSetting="Polite" />
                            <TextBlock Text="{Binding Message}" Style="{StaticResource ShownWhenBound}" Margin="0,0,0,4" AutomationProperties.LiveSetting="Polite" />
                        </StackPanel>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                            <ItemsControl ItemsSource="{Binding Items}" Focusable="False" KeyboardNavigation.TabNavigation="Continue"
                                          AutomationProperties.Name="{x:Static core:IndexStrings.IndexesListName}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type core:IndexFolderRowViewModel}">
                                        <Border Style="{StaticResource Card}" AutomationProperties.Name="{Binding AutomationName}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding RootText}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,4" />
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Static core:IndexStrings.DiskLabel}" Style="{StaticResource FieldLabel}" />
                                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding DiskText}" Style="{StaticResource FieldValue}" />
                                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{x:Static core:IndexStrings.RootExistsLabel}" Style="{StaticResource FieldLabel}" />
                                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding RootExistsText}" Style="{StaticResource FieldValue}" />
                                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{x:Static core:IndexStrings.InUseLabel}" Style="{StaticResource FieldLabel}" />
                                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding InUseText}" Style="{StaticResource FieldValue}" />
                                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="{x:Static core:IndexStrings.LastUsedLabel}" Style="{StaticResource FieldLabel}" />
                                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding LastUsedText}" Style="{StaticResource FieldValue}" />
                                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="{x:Static core:IndexStrings.ModelLabel}" Style="{StaticResource FieldLabel}" />
                                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding ModelText}" Style="{StaticResource FieldValue}" />
                                                </Grid>
                                                <Button Content="{x:Static core:IndexStrings.DeleteButton}" Command="{Binding DeleteCommand}" MinWidth="75" HorizontalAlignment="Left" Margin="0,6,0,0"
                                                        ToolTip="{x:Static core:IndexStrings.DeleteIndexToolTip}"
                                                        AutomationProperties.Name="{Binding DeleteName}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </TabItem>
            </TabControl>

            <!-- The result of the last action (a started rebuild, a delete, a refusal). -->
            <TextBlock Grid.Row="2" Text="{Binding ActionMessage}" Style="{StaticResource ShownWhenBound}" Margin="0,6,0,0" FontWeight="SemiBold"
                       AutomationProperties.Name="{Binding ActionMessage}"
                       AutomationProperties.LiveSetting="Polite" />
        </Grid>
    </DockPanel>
</UserControl>
