<UserControl x:Class="Pillion.VisualStudio.ToolWindows.ChatToolWindowControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:ClassModifier="internal"
             xmlns:core="clr-namespace:Pillion.VisualStudio.Core;assembly=Pillion.VisualStudio.Core"
             xmlns:local="clr-namespace:Pillion.VisualStudio.ToolWindows"
             xmlns:mentions="clr-namespace:Pillion.VisualStudio.Core.Mentions;assembly=Pillion.VisualStudio.Core"
             xmlns:vsshell="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0"
             xmlns:platformui="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
             xmlns:imaging="clr-namespace:Microsoft.VisualStudio.Imaging;assembly=Microsoft.VisualStudio.Imaging"
             platformui:ThemedDialogStyleLoader.UseDefaultThemedDialogStyles="True"
             Background="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBackgroundKey}}"
             Foreground="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}"
             FontFamily="{DynamicResource {x:Static vsshell:VsFonts.EnvironmentFontFamilyKey}}"
             FontSize="{DynamicResource {x:Static vsshell:VsFonts.EnvironmentFontSizeKey}}"
             AutomationProperties.Name="Pillion Chat">

    <!--
      Replies render as Markdown (Markdig, see local:MarkdownMessageView): themed WPF elements for prose, lists, tables and
      quotes, and read-only editor views for code blocks. Every colour comes from a Visual Studio theme key (VsBrushes /
      EnvironmentColors), so the window follows the light, dark, blue and high-contrast themes. State is never shown by
      colour alone: errors, stops and interruptions all have text. The transcript virtualises (pixel scrolling, recycled
      containers); rendered replies are cached per turn so scrolling never rebuilds them.
    -->
    <UserControl.Resources>
        <CollectionViewSource x:Key="GroupedModels" Source="{Binding ModelPicker.Models}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Group" />
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>

        <BooleanToVisibilityConverter x:Key="VisibleWhenTrue" />
        <local:MentionKindMonikerConverter x:Key="MentionIcon" />

        <Style x:Key="SecondaryText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:VsBrushes.GrayTextKey}}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!-- One turn: header naming the author (or the model and provider that answered), the text, and its state. -->
        <DataTemplate x:Key="TurnTemplate" DataType="{x:Type core:ChatTurnViewModel}">
            <Border x:Name="Turn"
                    Margin="0,0,0,10"
                    Padding="8,6,8,6"
                    BorderThickness="2,0,0,0"
                    BorderBrush="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBorderKey}}"
                    Focusable="True"
                    KeyboardNavigation.IsTabStop="False"
                    AutomationProperties.Name="{Binding AutomationName}">
                <StackPanel>
                    <TextBlock Text="{Binding Header}" FontWeight="SemiBold" Margin="0,0,0,2" />
                    <!-- The developer's message, as typed (selectable). -->
                    <TextBox x:Name="UserText"
                             Text="{Binding Text, Mode=OneWay}"
                             IsReadOnly="True"
                             IsTabStop="False"
                             TextWrapping="Wrap"
                             BorderThickness="0"
                             Padding="0"
                             Margin="0,2,0,2"
                             Background="Transparent"
                             Foreground="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}"
                             Visibility="Collapsed"
                             AutomationProperties.Name="{Binding Text}" />
                    <!-- The reply, rendered as Markdown. -->
                    <local:MarkdownMessageView x:Name="Reply" Turn="{Binding}" />
                    <!--
                      The spans the reply names (work item 2.2 restores them with a saved reply; 2.12 adds file:start-end spans), as
                      links that open the file with the span selected. Retrieved code the reply was given but did not name follows,
                      collapsed under a "Sources (n)" line.
                    -->
                    <StackPanel x:Name="CitationsPanel" Orientation="Horizontal" Margin="0,4,0,0" Visibility="Collapsed">
                        <TextBlock Text="{x:Static core:ChatStrings.CitationsLabel}" Style="{StaticResource SecondaryText}" Margin="0,0,6,0" />
                        <ItemsControl ItemsSource="{Binding ExplicitCitations}" Focusable="False" AutomationProperties.Name="{x:Static core:ChatStrings.CitationsLabel}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type core:CitationItem}">
                                    <TextBlock Margin="0,0,10,0">
                                        <Hyperlink Command="{Binding OpenCommand}"
                                                   CommandParameter="{Binding}"
                                                   ToolTip="{Binding ToolTip}"
                                                   Foreground="{DynamicResource {x:Static platformui:EnvironmentColors.ControlLinkTextBrushKey}}"
                                                   AutomationProperties.Name="{Binding AutomationName}">
                                            <Run Text="{Binding Text, Mode=OneWay}" />
                                        </Hyperlink>
                                    </TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <StackPanel x:Name="SourcesPanel" Margin="0,4,0,0" Visibility="Collapsed">
                        <TextBlock>
                            <Hyperlink Command="{Binding ToggleSourcesCommand}"
                                       Foreground="{DynamicResource {x:Static platformui:EnvironmentColors.ControlLinkTextBrushKey}}"
                                       AutomationProperties.Name="{Binding SourcesAutomationName}">
                                <Run Text="{Binding SourcesText, Mode=OneWay}" />
                            </Hyperlink>
                        </TextBlock>
                        <ItemsControl x:Name="SourcesList"
                                      ItemsSource="{Binding ImplicitCitations}"
                                      Focusable="False"
                                      Margin="12,2,0,0"
                                      Visibility="Collapsed"
                                      AutomationProperties.Name="{Binding SourcesText}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type core:CitationItem}">
                                    <TextBlock Margin="0,0,10,0">
                                        <Hyperlink Command="{Binding OpenCommand}"
                                                   CommandParameter="{Binding}"
                                                   ToolTip="{Binding ToolTip}"
                                                   Foreground="{DynamicResource {x:Static platformui:EnvironmentColors.ControlLinkTextBrushKey}}"
                                                   AutomationProperties.Name="{Binding AutomationName}">
                                            <Run Text="{Binding Text, Mode=OneWay}" />
                                        </Hyperlink>
                                    </TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <TextBlock x:Name="StateNote"
                               Text="{Binding StateText}"
                               Style="{StaticResource SecondaryText}"
                               FontStyle="Italic"
                               Visibility="Collapsed" />
                    <StackPanel x:Name="ErrorPanel" Visibility="Collapsed" Margin="0,4,0,0">
                        <TextBlock TextWrapping="Wrap" AutomationProperties.Name="{Binding ErrorMessage, StringFormat='Error: {0}'}">
                            <Run Text="Error: " FontWeight="SemiBold" /><Run Text="{Binding ErrorMessage, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock x:Name="Hint" Text="{Binding ErrorHint}" Style="{StaticResource SecondaryText}" Visibility="Collapsed" />
                    </StackPanel>
                    <Button x:Name="RetryButton"
                            Content="Retry"
                            Command="{Binding RetryCommand}"
                            CommandParameter="{Binding}"
                            HorizontalAlignment="Left"
                            MinWidth="70"
                            Margin="0,6,0,0"
                            Visibility="Collapsed"
                            AutomationProperties.Name="Retry this reply" />
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsUser}" Value="True">
                    <Setter TargetName="Turn" Property="BorderBrush" Value="{DynamicResource {x:Static platformui:EnvironmentColors.ToolWindowTabSelectedTabBrushKey}}" />
                    <Setter TargetName="UserText" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Reply" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="Reply" Property="Turn" Value="{x:Null}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasExplicitCitations}" Value="True">
                    <Setter TargetName="CitationsPanel" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasImplicitCitations}" Value="True">
                    <Setter TargetName="SourcesPanel" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding AreSourcesExpanded}" Value="True">
                    <Setter TargetName="SourcesList" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasStateText}" Value="True">
                    <Setter TargetName="StateNote" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasError}" Value="True">
                    <Setter TargetName="ErrorPanel" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasErrorHint}" Value="True">
                    <Setter TargetName="Hint" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding CanRetry}" Value="True">
                    <Setter TargetName="RetryButton" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel Margin="6" LastChildFill="True">

        <!-- Shown instead of a working chat while the chat feature flag is off (settings or repository policy). -->
        <TextBlock DockPanel.Dock="Top"
                   Text="{Binding ChatDisabledMessage}"
                   FontWeight="SemiBold"
                   TextWrapping="Wrap"
                   Margin="0,0,0,6"
                   AutomationProperties.Name="{Binding ChatDisabledMessage}"
                   AutomationProperties.LiveSetting="Polite">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsChatDisabled}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <!--
          Conversation list (work item 2.2): the conversations Pillion Host saved, newest first, read a page at a time as the list
          is scrolled; Rename and Delete are also in each entry's context menu. When the host cannot save conversations the list
          is the in-memory one and the notice below the row says so.
        -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Label Grid.Column="0" Content="{x:Static core:ChatStrings.ConversationLabel}" Target="{Binding ElementName=ConversationPicker}" VerticalAlignment="Center" Padding="0,0,6,0"
                   Foreground="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}" />
            <ComboBox x:Name="ConversationPicker"
                      Grid.Column="1"
                      ItemsSource="{Binding Conversations}"
                      SelectedItem="{Binding CurrentConversation, Mode=TwoWay}"
                      ScrollViewer.ScrollChanged="OnConversationListScrollChanged"
                      AutomationProperties.Name="{x:Static core:ChatStrings.ConversationListName}">
                <ComboBox.Style>
                    <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsRenaming}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ComboBox.Style>
                <ComboBox.ItemContainerStyle>
                    <Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
                        <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
                        <!-- The menu items get their Click handlers in code when the menu opens: an event attribute on an element inside a
                             setter value is compiled to the wrong connection id, and the window failed to build ("Set connectionId threw"). -->
                        <EventSetter Event="ContextMenuOpening" Handler="OnConversationItemContextMenuOpening" />
                        <Setter Property="ContextMenu">
                            <Setter.Value>
                                <ContextMenu>
                                    <MenuItem Header="{x:Static core:ChatStrings.ConversationMenuRename}" Tag="rename" />
                                    <MenuItem Header="{x:Static core:ChatStrings.ConversationMenuDelete}" Tag="delete" />
                                </ContextMenu>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ComboBox.ItemContainerStyle>
                <ComboBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type core:ChatConversation}">
                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBox x:Name="RenameBox"
                     Grid.Column="1"
                     Text="{Binding RenameText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Visibility="{Binding IsRenaming, Converter={StaticResource VisibleWhenTrue}}"
                     PreviewKeyDown="OnRenameKeyDown"
                     LostKeyboardFocus="OnRenameLostFocus"
                     IsVisibleChanged="OnRenameVisibleChanged"
                     AutomationProperties.Name="{x:Static core:ChatStrings.RenameBoxName}"
                     AutomationProperties.HelpText="{x:Static core:ChatStrings.RenameBoxHelp}" />
            <Button Grid.Column="2" Content="{x:Static core:ChatStrings.NewConversationButton}" Command="{Binding NewConversationCommand}" Margin="4,0,0,0" MinWidth="50"
                    AutomationProperties.Name="{x:Static core:ChatStrings.NewConversationName}" ToolTip="{x:Static core:ChatStrings.NewConversationToolTip}" />
            <Button Grid.Column="3" Content="{x:Static core:ChatStrings.RenameConversationButton}" Command="{Binding RenameConversationCommand}" Margin="4,0,0,0" MinWidth="50"
                    AutomationProperties.Name="{x:Static core:ChatStrings.RenameConversationName}" ToolTip="{x:Static core:ChatStrings.RenameConversationToolTip}" />
            <Button Grid.Column="4" Content="{x:Static core:ChatStrings.DeleteConversationButton}" Command="{Binding DeleteConversationCommand}" Margin="4,0,0,0" MinWidth="50"
                    AutomationProperties.Name="{x:Static core:ChatStrings.DeleteConversationName}" ToolTip="{x:Static core:ChatStrings.DeleteConversationToolTip}" />
        </Grid>

        <!-- Why conversations are not being saved, or that a rename or delete was not saved. -->
        <TextBlock DockPanel.Dock="Top"
                   Text="{Binding ConversationsNotice}"
                   Style="{StaticResource SecondaryText}"
                   Margin="0,0,0,4"
                   Visibility="{Binding HasConversationsNotice, Converter={StaticResource VisibleWhenTrue}}"
                   AutomationProperties.LiveSetting="Polite"
                   AutomationProperties.Name="{Binding ConversationsNotice}" />

        <!-- A saved conversation is being read, or could not be. -->
        <TextBlock DockPanel.Dock="Top"
                   Text="{x:Static core:ChatStrings.ConversationLoadingText}"
                   Style="{StaticResource SecondaryText}"
                   Margin="0,0,0,4"
                   Visibility="{Binding CurrentConversation.IsLoading, Converter={StaticResource VisibleWhenTrue}}"
                   AutomationProperties.LiveSetting="Polite" />
        <DockPanel DockPanel.Dock="Top"
                   Margin="0,0,0,4"
                   Visibility="{Binding CurrentConversation.HasLoadError, Converter={StaticResource VisibleWhenTrue}}">
            <Button DockPanel.Dock="Right" Content="{x:Static core:ChatStrings.ConversationRetryLoadButton}" Command="{Binding RetryLoadConversationCommand}" MinWidth="70" Margin="6,0,0,0"
                    AutomationProperties.Name="{x:Static core:ChatStrings.ConversationRetryLoadButton}" />
            <TextBlock Text="{Binding CurrentConversation.LoadError}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive"
                       AutomationProperties.Name="{Binding CurrentConversation.LoadError}" />
        </DockPanel>

        <!-- Model picker and conversation commands. -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Label Grid.Column="0" Content="_Model:" Target="{Binding ElementName=ModelPicker}" VerticalAlignment="Center" Padding="0,0,6,0"
                   Foreground="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}" />
            <ComboBox x:Name="ModelPicker"
                      Grid.Column="1"
                      ItemsSource="{Binding Source={StaticResource GroupedModels}}"
                      SelectedItem="{Binding ModelPicker.SelectedModel, Mode=TwoWay}"
                      AutomationProperties.Name="Model"
                      AutomationProperties.HelpText="Auto lets Pillion pick the model; then local models, then cloud models. Unavailable models say why.">
                <ComboBox.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="4,4,0,2" />
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ComboBox.GroupStyle>
                <ComboBox.ItemContainerStyle>
                    <Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
                        <Setter Property="IsEnabled" Value="{Binding IsAvailable}" />
                        <Setter Property="ToolTip" Value="{Binding ToolTip}" />
                        <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
                        <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
                    </Style>
                </ComboBox.ItemContainerStyle>
                <ComboBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type core:ModelOption}">
                        <StackPanel>
                            <TextBlock Text="{Binding DisplayText}" />
                            <TextBlock x:Name="Reason" Text="{Binding UnavailableReason}" FontStyle="Italic" TextWrapping="Wrap" MaxWidth="420" Visibility="Collapsed" />
                        </StackPanel>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                                <Setter TargetName="Reason" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <Button Grid.Column="2" Content="Refresh" Command="{Binding RefreshModelsCommand}" Margin="4,0,0,0" MinWidth="60"
                    AutomationProperties.Name="Refresh models" ToolTip="List the models again and re-read the privacy settings" />
            <Button Grid.Column="3" Content="Clear" Command="{Binding ClearCommand}" Margin="4,0,0,0" MinWidth="60"
                    AutomationProperties.Name="Clear conversation" ToolTip="Clear the conversation" />
        </Grid>

        <TextBlock DockPanel.Dock="Top"
                   x:Name="PickerMessage"
                   Text="{Binding ModelPicker.Message}"
                   Margin="0,0,0,4"
                   AutomationProperties.LiveSetting="Polite">
            <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource SecondaryText}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ModelPicker.HasMessage}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <!-- Status line: the host state, with Open Logs when it has failed. -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,4,0,0">
            <TextBlock DockPanel.Dock="Right" Margin="8,0,0,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsHostFailed}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
                <Hyperlink Command="{Binding OpenLogsCommand}"
                           Foreground="{DynamicResource {x:Static platformui:EnvironmentColors.ControlLinkTextBrushKey}}"
                           AutomationProperties.Name="Open Logs">
                    <Run Text="Open Logs" />
                </Hyperlink>
            </TextBlock>
            <TextBlock Text="{Binding StatusText}"
                       Style="{StaticResource SecondaryText}"
                       AutomationProperties.Name="{Binding StatusText, StringFormat='Pillion Host status: {0}'}"
                       AutomationProperties.LiveSetting="Polite" />
        </DockPanel>

        <!--
          The Outbound log (work item 1.13): every request sent to any model, newest first, counts and durations only. Shown
          while the outboundLogView feature flag is on.
        -->
        <Expander x:Name="OutboundLogExpander"
                  DockPanel.Dock="Bottom"
                  Margin="0,4,0,0"
                  IsExpanded="{Binding OutboundLog.IsExpanded, Mode=TwoWay}"
                  Visibility="{Binding IsOutboundLogEnabled, Converter={StaticResource VisibleWhenTrue}}"
                  Foreground="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}"
                  AutomationProperties.Name="{x:Static core:ChatStrings.OutboundListName}">
            <Expander.Header>
                <TextBlock>
                    <AccessText Text="{x:Static core:ChatStrings.OutboundLogHeader}" FontWeight="SemiBold" />
                    <Run Text=" " /><Run Text="{Binding OutboundLog.Summary, Mode=OneWay}" Foreground="{DynamicResource {x:Static vsshell:VsBrushes.GrayTextKey}}" />
                </TextBlock>
            </Expander.Header>
            <DockPanel Margin="0,4,0,0">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
                    <Button Content="{x:Static core:ChatStrings.OutboundRefreshButton}" Command="{Binding OutboundLog.RefreshCommand}" MinWidth="60"
                            AutomationProperties.Name="{x:Static core:ChatStrings.OutboundRefreshName}" ToolTip="{x:Static core:ChatStrings.OutboundRefreshName}" />
                    <Button Content="{x:Static core:ChatStrings.OutboundCopyButton}" Command="{Binding OutboundLog.CopyCommand}" MinWidth="60" Margin="4,0,0,0"
                            AutomationProperties.Name="{x:Static core:ChatStrings.OutboundCopyName}" ToolTip="{x:Static core:ChatStrings.OutboundCopyName}" />
                </StackPanel>
                <TextBlock DockPanel.Dock="Top" Text="{Binding OutboundLog.Error}" Style="{StaticResource SecondaryText}"
                           Visibility="{Binding OutboundLog.HasError, Converter={StaticResource VisibleWhenTrue}}" AutomationProperties.LiveSetting="Polite" />
                <ListView x:Name="OutboundList"
                          ItemsSource="{Binding OutboundLog.Records}"
                          MaxHeight="220"
                          Background="{DynamicResource {x:Static vsshell:VsBrushes.WindowKey}}"
                          Foreground="{DynamicResource {x:Static vsshell:VsBrushes.WindowTextKey}}"
                          BorderBrush="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBorderKey}}"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          AutomationProperties.Name="{x:Static core:ChatStrings.OutboundListName}">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
                            <Setter Property="ToolTip" Value="{Binding Context}" />
                            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:VsBrushes.WindowTextKey}}" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="{x:Static core:ChatStrings.OutboundColumnTime}" DisplayMemberBinding="{Binding Time}" />
                            <GridViewColumn Header="{x:Static core:ChatStrings.OutboundColumnTaskClass}" DisplayMemberBinding="{Binding TaskClass}" />
                            <GridViewColumn Header="{x:Static core:ChatStrings.OutboundColumnModel}" DisplayMemberBinding="{Binding ProviderModel}" />
                            <GridViewColumn Header="{x:Static core:ChatStrings.OutboundColumnLocality}" DisplayMemberBinding="{Binding Locality}" />
                            <GridViewColumn Header="{x:Static core:ChatStrings.OutboundColumnTokens}" DisplayMemberBinding="{Binding Tokens}" />
                            <GridViewColumn Header="{x:Static core:ChatStrings.OutboundColumnRedactions}" DisplayMemberBinding="{Binding Redactions}" />
                            <GridViewColumn Header="{x:Static core:ChatStrings.OutboundColumnDuration}" DisplayMemberBinding="{Binding Duration}" />
                            <GridViewColumn Header="{x:Static core:ChatStrings.OutboundColumnOutcome}" DisplayMemberBinding="{Binding Outcome}" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </DockPanel>
        </Expander>

        <!-- Input: Enter sends, Shift+Enter inserts a new line; @ opens the mention picker at the caret. -->
        <Grid DockPanel.Dock="Bottom" Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBox x:Name="Input"
                     Grid.Column="0"
                     Text="{Binding InputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     IsEnabled="{Binding IsChatEnabled}"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     MinHeight="48"
                     MaxHeight="160"
                     VerticalScrollBarVisibility="Auto"
                     SpellCheck.IsEnabled="False"
                     PreviewKeyDown="OnInputPreviewKeyDown"
                     TextChanged="OnInputTextChanged"
                     SelectionChanged="OnInputSelectionChanged"
                     LostKeyboardFocus="OnInputLostKeyboardFocus"
                     AutomationProperties.Name="Message"
                     AutomationProperties.HelpText="Type a message. Enter sends; Shift+Enter starts a new line. Type @ to pin a file, folder, the selection, the errors or the clipboard." />
            <CheckBox Grid.Row="1"
                      Grid.Column="0"
                      Margin="0,4,0,0"
                      IsChecked="{Binding IncludeCurrentFile, Mode=TwoWay}"
                      Visibility="{Binding IsMentionsEnabled, Converter={StaticResource VisibleWhenTrue}}"
                      Foreground="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}"
                      ToolTip="{x:Static core:ChatStrings.IncludeCurrentFileHelp}"
                      AutomationProperties.HelpText="{x:Static core:ChatStrings.IncludeCurrentFileHelp}">
                <AccessText Text="{x:Static core:ChatStrings.IncludeCurrentFileLabel}" />
            </CheckBox>
            <StackPanel Grid.Column="1" Grid.RowSpan="2" Margin="4,0,0,0" VerticalAlignment="Bottom">
                <Button Content="Send" Command="{Binding SendCommand}" MinWidth="70" Margin="0,0,0,4"
                        AutomationProperties.Name="Send" ToolTip="Send (Enter)" />
                <Button Command="{Binding InspectContextCommand}" MinWidth="70" Margin="0,0,0,4"
                        Visibility="{Binding IsOutboundLogEnabled, Converter={StaticResource VisibleWhenTrue}}"
                        AutomationProperties.Name="{x:Static core:ChatStrings.InspectContextName}" ToolTip="{x:Static core:ChatStrings.InspectContextToolTip}">
                    <AccessText Text="{x:Static core:ChatStrings.InspectContextButton}" />
                </Button>
                <Button Content="Stop" Command="{Binding StopCommand}" MinWidth="70"
                        AutomationProperties.Name="Stop" ToolTip="Stop the reply" />
            </StackPanel>

            <!--
              The mention picker, at the caret (work items 1.9 and 2.13): entries grouped under headings (kinds with their hint
              lines, files, folders, symbols, docs, the @git and @output options), each with its kind's icon; also the sub-picker
              of an ambiguous match. Keyboard only: the input keeps the focus, Up and Down move, Enter or Tab pick, Esc closes.
              A heading is part of its group's first entry, so it never takes a keyboard stop and is announced with that entry.
            -->
            <Popup x:Name="MentionPopup"
                   PlacementTarget="{Binding ElementName=Input}"
                   Placement="Top"
                   AllowsTransparency="True"
                   StaysOpen="True"
                   Focusable="False"
                   IsOpen="{Binding Mentions.Picker.IsOpen, Mode=OneWay}">
                <Border Background="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBackgroundKey}}"
                        BorderBrush="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBorderKey}}"
                        BorderThickness="1"
                        Padding="4"
                        MinWidth="260"
                        MaxWidth="480">
                    <StackPanel>
                        <TextBlock Text="{Binding Mentions.Picker.Title}" Style="{StaticResource SecondaryText}" Margin="2,0,2,4"
                                   AutomationProperties.LiveSetting="Polite" />
                        <ListBox x:Name="MentionList"
                                 ItemsSource="{Binding Mentions.Picker.Items}"
                                 SelectedIndex="{Binding Mentions.Picker.SelectedIndex, Mode=OneWay}"
                                 Focusable="False"
                                 MaxHeight="260"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 AutomationProperties.Name="{x:Static core:ChatStrings.MentionPickerName}">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Focusable" Value="False" />
                                    <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
                                    <Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}" />
                                    <Setter Property="Padding" Value="4,2,4,2" />
                                    <EventSetter Event="PreviewMouseLeftButtonUp" Handler="OnMentionItemClicked" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource {x:Static platformui:EnvironmentColors.CommandBarMouseOverBackgroundBeginBrushKey}}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type mentions:MentionPickerItem}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Group}" Style="{StaticResource SecondaryText}" FontWeight="SemiBold" Margin="0,4,0,2"
                                                   Visibility="{Binding IsFirstInGroup, Converter={StaticResource VisibleWhenTrue}}" />
                                        <DockPanel>
                                            <imaging:CrispImage DockPanel.Dock="Left" Width="16" Height="16" Margin="0,1,6,0" VerticalAlignment="Top"
                                                                Moniker="{Binding MentionKind, Converter={StaticResource MentionIcon}}"
                                                                AutomationProperties.Name="" Focusable="False" />
                                            <StackPanel>
                                                <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Detail}" Style="{StaticResource SecondaryText}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                            </StackPanel>
                                        </DockPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>
            </Popup>
        </Grid>

        <!-- Pins (work item 1.9): the context pinned to this conversation, each with its token badge; approval and notices. -->
        <StackPanel DockPanel.Dock="Bottom"
                    Margin="0,4,0,0"
                    Visibility="{Binding IsMentionsEnabled, Converter={StaticResource VisibleWhenTrue}}">
            <ItemsControl x:Name="PinList"
                          ItemsSource="{Binding Mentions.Pins}"
                          Focusable="False"
                          AutomationProperties.Name="{x:Static core:ChatStrings.PinsListName}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type mentions:MentionPin}">
                        <Border Margin="0,0,4,4"
                                Padding="5,1,2,1"
                                CornerRadius="3"
                                BorderThickness="1"
                                BorderBrush="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBorderKey}}"
                                ToolTip="{Binding ToolTip}"
                                AutomationProperties.Name="{Binding AutomationName}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="Lock" Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,4,0" Visibility="Collapsed"
                                           AutomationProperties.Name="{x:Static core:ChatStrings.SensitiveGlyphName}" />
                                <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding TokenBadge}" VerticalAlignment="Center" Margin="6,0,0,0" Style="{StaticResource SecondaryText}" />
                                <TextBlock x:Name="StaleNote" Text="{x:Static core:ChatStrings.PinStaleShort}" VerticalAlignment="Center" Margin="4,0,0,0" FontStyle="Italic"
                                           Style="{StaticResource SecondaryText}" Visibility="Collapsed" />
                                <Button Content="&#xE711;"
                                        FontFamily="Segoe MDL2 Assets"
                                        FontSize="9"
                                        Padding="3,1,3,1"
                                        Margin="4,0,0,0"
                                        MinWidth="0"
                                        VerticalAlignment="Center"
                                        Command="{Binding DataContext.Mentions.RemovePinCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        ToolTip="{x:Static core:ChatStrings.RemovePinToolTip}"
                                        AutomationProperties.Name="{Binding RemoveAutomationName}" />
                            </StackPanel>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsSensitive}" Value="True">
                                <Setter TargetName="Lock" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsStale}" Value="True">
                                <Setter TargetName="StaleNote" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Per-file approval for an excluded or secret file. -->
            <Border Visibility="{Binding Mentions.HasPendingApproval, Converter={StaticResource VisibleWhenTrue}}"
                    BorderThickness="2,0,0,0"
                    BorderBrush="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBorderKey}}"
                    Padding="6,2,2,2"
                    Margin="0,0,0,4">
                <StackPanel>
                    <TextBlock Text="{Binding Mentions.PendingApproval.Prompt}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive"
                               AutomationProperties.Name="{Binding Mentions.PendingApproval.Prompt}" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <Button Command="{Binding Mentions.ApproveCommand}" MinWidth="80">
                            <AccessText Text="{x:Static core:ChatStrings.PinApproveButton}" />
                        </Button>
                        <Button Command="{Binding Mentions.DeclineCommand}" MinWidth="80" Margin="4,0,0,0">
                            <AccessText Text="{x:Static core:ChatStrings.PinDeclineButton}" />
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Why a mention did not resolve. -->
            <DockPanel Visibility="{Binding Mentions.HasNotice, Converter={StaticResource VisibleWhenTrue}}" Margin="0,0,0,4">
                <Button DockPanel.Dock="Right" Content="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="9" Padding="3,1,3,1" MinWidth="0" VerticalAlignment="Top"
                        Command="{Binding Mentions.DismissNoticeCommand}"
                        ToolTip="{x:Static core:ChatStrings.DismissNoticeName}" AutomationProperties.Name="{x:Static core:ChatStrings.DismissNoticeName}" />
                <TextBlock Text="{Binding Mentions.Notice}" Style="{StaticResource SecondaryText}" AutomationProperties.LiveSetting="Polite"
                           AutomationProperties.Name="{Binding Mentions.Notice}" />
            </DockPanel>
        </StackPanel>

        <!-- The Context Inspector (work item 1.13): the context the message would be sent with, before it is sent. -->
        <Border x:Name="InspectorPanel"
                DockPanel.Dock="Bottom"
                Margin="0,4,0,0"
                Padding="6"
                BorderThickness="1"
                BorderBrush="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBorderKey}}"
                Visibility="{Binding Inspector.IsOpen, Converter={StaticResource VisibleWhenTrue}}"
                AutomationProperties.Name="{x:Static core:ChatStrings.InspectorTitle}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="{x:Static core:ChatStrings.InspectorTitle}" FontWeight="SemiBold" />
                <TextBlock DockPanel.Dock="Top" Text="{Binding Inspector.Summary}" TextWrapping="Wrap" Margin="0,2,0,0" AutomationProperties.LiveSetting="Polite" />
                <TextBlock DockPanel.Dock="Top" Text="{x:Static core:ChatStrings.InspectorLoading}" Style="{StaticResource SecondaryText}"
                           Visibility="{Binding Inspector.IsLoading, Converter={StaticResource VisibleWhenTrue}}" />
                <TextBlock DockPanel.Dock="Top" Text="{Binding Inspector.Error}" TextWrapping="Wrap"
                           Visibility="{Binding Inspector.HasError, Converter={StaticResource VisibleWhenTrue}}" AutomationProperties.LiveSetting="Assertive" />
                <TextBlock DockPanel.Dock="Top" Text="{Binding Inspector.ModeNote}" Style="{StaticResource SecondaryText}"
                           Visibility="{Binding Inspector.HasModeNote, Converter={StaticResource VisibleWhenTrue}}" />
                <TextBlock DockPanel.Dock="Top" Text="{Binding Inspector.RedactionNotice}" TextWrapping="Wrap" FontWeight="SemiBold"
                           Visibility="{Binding Inspector.HasRedactionNotice, Converter={StaticResource VisibleWhenTrue}}" />
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                    <Button Content="{x:Static core:ChatStrings.InspectorSendButton}" Command="{Binding Inspector.SendCommand}" MinWidth="70"
                            AutomationProperties.Name="{x:Static core:ChatStrings.InspectorSendButton}" />
                    <Button Content="{x:Static core:ChatStrings.InspectorCloseButton}" Command="{Binding Inspector.CloseCommand}" MinWidth="70" Margin="4,0,0,0"
                            AutomationProperties.Name="{x:Static core:ChatStrings.InspectorCloseButton}" />
                </StackPanel>
                <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,4,0,0" Focusable="False">
                    <ItemsControl ItemsSource="{Binding Inspector.Items}" Focusable="False" AutomationProperties.Name="{x:Static core:ChatStrings.InspectorListName}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type core:ContextInspectorItem}">
                                <Grid Margin="0,0,0,4" AutomationProperties.Name="{Binding AutomationName}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock TextTrimming="CharacterEllipsis">
                                            <Run Text="{Binding KindPrefix, Mode=OneWay}" Foreground="{DynamicResource {x:Static vsshell:VsBrushes.GrayTextKey}}" /><Run Text="  " /><Run Text="{Binding Name, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock x:Name="State" Text="{Binding StateText}" Style="{StaticResource SecondaryText}" FontStyle="Italic" Visibility="Collapsed" />
                                        <TextBlock x:Name="Redaction" Text="{Binding RedactionText}" TextWrapping="Wrap" Visibility="Collapsed" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding TokensText}" Margin="8,0,0,0" VerticalAlignment="Top" />
                                    <Button x:Name="Remove"
                                            Grid.Column="2"
                                            Content="&#xE711;"
                                            FontFamily="Segoe MDL2 Assets"
                                            FontSize="9"
                                            Padding="3,1,3,1"
                                            Margin="6,0,0,0"
                                            MinWidth="0"
                                            VerticalAlignment="Top"
                                            Visibility="Hidden"
                                            Command="{Binding DataContext.Inspector.RemoveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="{Binding RemoveAutomationName}"
                                            AutomationProperties.Name="{Binding RemoveAutomationName}" />
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding HasStateText}" Value="True">
                                        <Setter TargetName="State" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding HasRedaction}" Value="True">
                                        <Setter TargetName="Redaction" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding CanRemove}" Value="True">
                                        <Setter TargetName="Remove" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Transcript: a virtualising list (pixel scrolling, recycled containers). -->
        <local:TranscriptItemsControl x:Name="Transcript"
                      ItemsSource="{Binding Turns}"
                      ItemTemplate="{StaticResource TurnTemplate}"
                      Focusable="False"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      VirtualizingPanel.ScrollUnit="Pixel"
                      VirtualizingPanel.CacheLengthUnit="Page"
                      VirtualizingPanel.CacheLength="1,1"
                      ScrollViewer.CanContentScroll="True"
                      ScrollViewer.ScrollChanged="OnTranscriptScrollChanged"
                      AutomationProperties.Name="Conversation"
                      AutomationProperties.AutomationId="TranscriptScroller">
            <ItemsControl.Template>
                <ControlTemplate TargetType="ItemsControl">
                    <ScrollViewer x:Name="PART_Scroller"
                                  CanContentScroll="True"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Focusable="False">
                        <ItemsPresenter />
                    </ScrollViewer>
                </ControlTemplate>
            </ItemsControl.Template>
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </local:TranscriptItemsControl>
    </DockPanel>
</UserControl>
