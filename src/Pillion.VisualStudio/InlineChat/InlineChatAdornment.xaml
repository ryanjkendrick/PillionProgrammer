<UserControl x:Class="Pillion.VisualStudio.InlineChat.InlineChatAdornment"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:ClassModifier="internal"
             xmlns:core="clr-namespace:Pillion.VisualStudio.Core;assembly=Pillion.VisualStudio.Core"
             xmlns:ic="clr-namespace:Pillion.VisualStudio.Core.InlineChat;assembly=Pillion.VisualStudio.Core"
             xmlns:vsshell="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0"
             xmlns:platformui="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
             platformui:ThemedDialogStyleLoader.UseDefaultThemedDialogStyles="True"
             Background="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBackgroundKey}}"
             Foreground="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowTextKey}}"
             FontFamily="{DynamicResource {x:Static vsshell:VsFonts.EnvironmentFontFamilyKey}}"
             FontSize="{DynamicResource {x:Static vsshell:VsFonts.EnvironmentFontSizeKey}}"
             Cursor="Arrow"
             KeyboardNavigation.TabNavigation="Cycle"
             KeyboardNavigation.DirectionalNavigation="None"
             AutomationProperties.Name="Pillion inline chat"
             AutomationProperties.AutomationId="PillionInlineChat"
             AutomationProperties.HelpText="Type an instruction for the highlighted code and press Enter. Enter applies the proposal, Esc discards it.">

    <!--
      Work items 1.6 and 1.7 (design section 5): the inline chat adornment. Every colour comes from a Visual Studio theme
      key, and nothing is shown by colour alone: errors, warnings and notes have text, and the difference view has
      +/- markers. Every control is in the tab order (Tab cycles inside the adornment) and has a screen-reader name.
      All behaviour is in InlineChatSession; the keys the editor would otherwise take are routed here by
      InlineChatCommandFilter.
    -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />

        <CollectionViewSource x:Key="GroupedModels" Source="{Binding ModelPicker.Models}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Group" />
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>

        <Style x:Key="SecondaryText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsshell:VsBrushes.GrayTextKey}}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinWidth" Value="64" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="Padding" Value="8,1,8,1" />
        </Style>
    </UserControl.Resources>

    <Border BorderThickness="1"
            BorderBrush="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBorderKey}}"
            Padding="6,5,6,5">
        <StackPanel>

            <!-- Shown while the inlineChat feature flag is off (settings or repository policy). -->
            <TextBlock Text="{Binding DisabledMessage}"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap"
                       Margin="0,0,0,4"
                       x:Name="DisabledNote"
                       AutomationProperties.LiveSetting="Polite">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- The prompt line: instruction, model, recent prompts, close. -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="160" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <TextBox x:Name="Prompt"
                             Text="{Binding PromptText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             VerticalContentAlignment="Center"
                             Padding="3,2,3,2"
                             Background="{DynamicResource {x:Static vsshell:VsBrushes.WindowKey}}"
                             Foreground="{DynamicResource {x:Static vsshell:VsBrushes.WindowTextKey}}"
                             CaretBrush="{DynamicResource {x:Static vsshell:VsBrushes.WindowTextKey}}"
                             BorderBrush="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBorderKey}}"
                             AcceptsReturn="False"
                             AcceptsTab="False"
                             TabIndex="0"
                             AutomationProperties.AutomationId="PillionInlineChatPrompt"
                             AutomationProperties.Name="Inline chat instruction"
                             AutomationProperties.HelpText="{Binding Placeholder}" />
                    <TextBlock Text="{Binding Placeholder}"
                               IsHitTestVisible="False"
                               Margin="6,0,6,0"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource {x:Static vsshell:VsBrushes.GrayTextKey}}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasPromptText}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <ComboBox x:Name="ModelPicker"
                          Grid.Column="1"
                          Margin="4,0,0,0"
                          MinWidth="150"
                          MaxWidth="260"
                          TabIndex="1"
                          ItemsSource="{Binding Source={StaticResource GroupedModels}}"
                          SelectedItem="{Binding ModelPicker.SelectedModel, Mode=TwoWay}"
                          ToolTip="{Binding ModelPicker.Message}"
                          AutomationProperties.AutomationId="PillionInlineChatModel"
                          AutomationProperties.Name="Model"
                          AutomationProperties.HelpText="Auto lets Pillion pick the model for inline edits; then local models, then cloud models.">
                    <ComboBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="4,4,0,2" />
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ComboBox.GroupStyle>
                    <ComboBox.ItemContainerStyle>
                        <Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
                            <Setter Property="IsEnabled" Value="{Binding IsAvailable}" />
                            <Setter Property="ToolTip" Value="{Binding ToolTip}" />
                            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
                            <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
                        </Style>
                    </ComboBox.ItemContainerStyle>
                    <ComboBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type core:ModelOption}">
                            <TextBlock Text="{Binding DisplayText}" TextTrimming="CharacterEllipsis" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <Grid Grid.Column="2" Margin="4,0,0,0">
                    <ComboBox x:Name="Recent"
                              Width="96"
                              TabIndex="2"
                              ItemsSource="{Binding RecentPrompts}"
                              SelectionChanged="OnRecentSelected"
                              AutomationProperties.AutomationId="PillionInlineChatRecent"
                              AutomationProperties.Name="Recent prompts"
                              AutomationProperties.HelpText="The last ten prompts of this Visual Studio session. Choosing one puts it in the prompt.">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" MaxWidth="480" TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Text="Recent"
                               IsHitTestVisible="False"
                               Margin="6,0,20,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource {x:Static vsshell:VsBrushes.GrayTextKey}}" />
                </Grid>

                <Button Grid.Column="3"
                        Content="Close"
                        Style="{StaticResource SmallButton}"
                        MinWidth="0"
                        TabIndex="20"
                        Command="{Binding DiscardCommand}"
                        ToolTip="Discard and close (Esc)"
                        AutomationProperties.AutomationId="PillionInlineChatClose"
                        AutomationProperties.Name="Discard and close" />
            </Grid>

            <!-- Slash-command completion: shown while the prompt is / and part of a name. -->
            <ListBox x:Name="Suggestions"
                     Margin="0,2,0,0"
                     Focusable="False"
                     ItemsSource="{Binding SlashSuggestions}"
                     SelectedItem="{Binding SelectedSuggestion, Mode=TwoWay}"
                     Visibility="{Binding HasSuggestions, Converter={StaticResource Visible}}"
                     Background="{DynamicResource {x:Static vsshell:VsBrushes.WindowKey}}"
                     Foreground="{DynamicResource {x:Static vsshell:VsBrushes.WindowTextKey}}"
                     BorderBrush="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBorderKey}}"
                     PreviewMouseLeftButtonUp="OnSuggestionClicked"
                     AutomationProperties.Name="Slash commands">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                        <Setter Property="Focusable" Value="False" />
                        <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type ic:SlashCommandInfo}">
                        <TextBlock>
                            <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="  " /><Run Text="{Binding Description, Mode=OneWay}" />
                        </TextBlock>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Status line: Thinking, the model, the elapsed time, Stop and Retry. -->
            <DockPanel Margin="0,4,0,0" LastChildFill="True">
                <Button DockPanel.Dock="Right"
                        Content="Retry"
                        Style="{StaticResource SmallButton}"
                        TabIndex="11"
                        Command="{Binding RetryCommand}"
                        Visibility="{Binding CanRetry, Converter={StaticResource Visible}}"
                        AutomationProperties.AutomationId="PillionInlineChatRetry"
                        AutomationProperties.Name="Retry the request" />
                <Button DockPanel.Dock="Right"
                        Content="Stop"
                        Style="{StaticResource SmallButton}"
                        TabIndex="10"
                        Command="{Binding StopCommand}"
                        Visibility="{Binding IsBusy, Converter={StaticResource Visible}}"
                        AutomationProperties.AutomationId="PillionInlineChatStop"
                        AutomationProperties.Name="Stop the request" />
                <TextBlock DockPanel.Dock="Right"
                           Text="{Binding ElapsedText}"
                           Margin="8,0,0,0"
                           VerticalAlignment="Center"
                           Style="{StaticResource SecondaryText}"
                           AutomationProperties.Name="{Binding ElapsedText, StringFormat='Elapsed {0}'}" />
                <TextBlock Text="{Binding StatusText}"
                           VerticalAlignment="Center"
                           Style="{StaticResource SecondaryText}"
                           AutomationProperties.AutomationId="PillionInlineChatStatus"
                           AutomationProperties.LiveSetting="Polite" />
            </DockPanel>

            <TextBlock TextWrapping="Wrap"
                       Margin="0,4,0,0"
                       Visibility="{Binding HasError, Converter={StaticResource Visible}}"
                       AutomationProperties.AutomationId="PillionInlineChatError"
                       AutomationProperties.Name="{Binding ErrorText, StringFormat='Error: {0}'}"
                       AutomationProperties.LiveSetting="Assertive">
                <Run Text="Error: " FontWeight="SemiBold" /><Run Text="{Binding ErrorText, Mode=OneWay}" />
            </TextBlock>

            <TextBlock TextWrapping="Wrap"
                       Margin="0,4,0,0"
                       Visibility="{Binding HasWarning, Converter={StaticResource Visible}}"
                       AutomationProperties.AutomationId="PillionInlineChatWarning"
                       AutomationProperties.Name="{Binding Warning, StringFormat='Warning: {0}'}"
                       AutomationProperties.LiveSetting="Polite">
                <Run Text="Warning: " FontWeight="SemiBold" /><Run Text="{Binding Warning, Mode=OneWay}" />
            </TextBlock>

            <TextBlock Text="{Binding Note}"
                       Margin="0,2,0,0"
                       FontStyle="Italic"
                       Style="{StaticResource SecondaryText}"
                       Visibility="{Binding HasNote, Converter={StaticResource Visible}}" />

            <!-- /test: where the new code belongs. -->
            <TextBlock x:Name="TestNote"
                       TextWrapping="Wrap"
                       Margin="0,4,0,0"
                       Visibility="{Binding IsTestResult, Converter={StaticResource Visible}}"
                       AutomationProperties.Name="{Binding Explanation, StringFormat='Where it belongs: {0}'}">
                <Run Text="Where it belongs: " FontWeight="SemiBold" /><Run Text="{Binding Explanation, Mode=OneWay}" />
            </TextBlock>

            <!-- The inline difference view, hosted by InlineChatController while a proposal streams or is shown. -->
            <ContentPresenter x:Name="DiffHost" Margin="0,4,0,0" Visibility="Collapsed" />

            <!-- /explain: the answer, selectable and readable by screen readers. -->
            <TextBox x:Name="ExplanationBox"
                     Margin="0,4,0,0"
                     Text="{Binding Explanation, Mode=OneWay}"
                     IsReadOnly="True"
                     TextWrapping="Wrap"
                     MaxHeight="320"
                     VerticalScrollBarVisibility="Auto"
                     TabIndex="5"
                     Background="{DynamicResource {x:Static vsshell:VsBrushes.WindowKey}}"
                     Foreground="{DynamicResource {x:Static vsshell:VsBrushes.WindowTextKey}}"
                     BorderBrush="{DynamicResource {x:Static vsshell:VsBrushes.ToolWindowBorderKey}}"
                     Visibility="{Binding ShowsExplanation, Converter={StaticResource Visible}}"
                     AutomationProperties.AutomationId="PillionInlineChatExplanation"
                     AutomationProperties.Name="Explanation" />

            <!-- Actions. Enter and Esc do the same as Apply and Discard. -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                <Button Content="Apply (Enter)"
                        Style="{StaticResource SmallButton}"
                        TabIndex="12"
                        Command="{Binding AcceptCommand}"
                        Visibility="{Binding CanAccept, Converter={StaticResource Visible}}"
                        AutomationProperties.AutomationId="PillionInlineChatApply"
                        AutomationProperties.Name="Apply the proposal" />
                <Button Content="Insert at cursor"
                        Style="{StaticResource SmallButton}"
                        TabIndex="13"
                        Command="{Binding InsertCommand}"
                        Visibility="{Binding CanInsert, Converter={StaticResource Visible}}"
                        AutomationProperties.AutomationId="PillionInlineChatInsert"
                        AutomationProperties.Name="Insert the test code at the cursor" />
                <Button Content="Copy"
                        Style="{StaticResource SmallButton}"
                        TabIndex="14"
                        Command="{Binding CopyCommand}"
                        Visibility="{Binding CanInsert, Converter={StaticResource Visible}}"
                        AutomationProperties.AutomationId="PillionInlineChatCopy"
                        AutomationProperties.Name="Copy the test code" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
