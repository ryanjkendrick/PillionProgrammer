<UserControl x:Class="Pillion.VisualStudio.Options.AutocompleteOptionsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:ClassModifier="internal"
                          xmlns:vsshell="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0"
             Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
             Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"
             FontFamily="{DynamicResource {x:Static vsshell:VsFonts.EnvironmentFontFamilyKey}}"
             FontSize="{DynamicResource {x:Static vsshell:VsFonts.EnvironmentFontSizeKey}}"
             AutomationProperties.Name="Pillion Programmer autocomplete">

    <UserControl.Resources>
        <Style x:Key="Note" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="20,0,0,8" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
        </Style>
    </UserControl.Resources>

    <DockPanel Margin="4">
        <TextBlock DockPanel.Dock="Top"
                   Text="{Binding StatusMessage}"
                   FontWeight="SemiBold"
                   TextWrapping="Wrap"
                   Margin="0,0,0,6"
                   AutomationProperties.Name="{Binding StatusMessage, StringFormat='Status: {0}'}"
                   AutomationProperties.LiveSetting="Polite" />

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
            <Button Content="Save" Command="{Binding SaveCommand}" MinWidth="75" AutomationProperties.Name="Save autocomplete settings" />
            <Button Content="Reload" Command="{Binding ReloadCommand}" MinWidth="75" Margin="6,0,0,0" AutomationProperties.Name="Reload autocomplete settings" />
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
            <StackPanel IsEnabled="{Binding IsLoaded}">
                <TextBlock Text="When Copilot or IntelliCode also suggest" FontWeight="SemiBold" Margin="0,0,0,2" />
                <TextBlock Text="Who gets the ghost-text slot when another inline-suggestion provider is on. Pillion never changes the other product's settings."
                           TextWrapping="Wrap" Margin="0,0,0,6" />
                <ComboBox ItemsSource="{Binding Orderings}"
                          SelectedItem="{Binding Ordering}"
                          DisplayMemberPath="Label"
                          HorizontalAlignment="Left"
                          MinWidth="220"
                          AutomationProperties.Name="Ordering against other inline-suggestion providers" />
                <TextBlock Text="{Binding Ordering.Description}" Style="{StaticResource Note}" Margin="0,4,0,4" />

                <CheckBox Content="_Ask again at the next start when another provider is on"
                          IsChecked="{Binding AskAgain}"
                          Margin="0,4,0,8"
                          AutomationProperties.Name="Ask again at the next start when another provider is on" />

                <TextBlock Text="Languages without suggestions" FontWeight="SemiBold" Margin="0,8,0,2" />
                <TextBox Text="{Binding DisabledLanguages, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="Language identifiers without suggestions, separated by commas" />
                <TextBlock Text="Language identifiers separated by commas, for example: python, xaml."
                           Style="{StaticResource Note}" Margin="0,2,0,8" />

                <CheckBox Content="A_nnounce new suggestions to screen readers"
                          IsChecked="{Binding AnnounceSuggestions}"
                          AutomationProperties.Name="Announce new suggestions to screen readers" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
