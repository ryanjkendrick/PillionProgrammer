<UserControl x:Class="Pillion.VisualStudio.Options.RoutingOptionsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:ClassModifier="internal"
             xmlns:core="clr-namespace:Pillion.VisualStudio.Core;assembly=Pillion.VisualStudio.Core"
             xmlns:vsshell="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0"
             Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
             Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"
             FontFamily="{DynamicResource {x:Static vsshell:VsFonts.EnvironmentFontFamilyKey}}"
             FontSize="{DynamicResource {x:Static vsshell:VsFonts.EnvironmentFontSizeKey}}"
             AutomationProperties.Name="Pillion Programmer models and routing">

    <!--
      Windows system colours with the page's own background, as on the other Options pages: the legacy Tools > Options
      dialog is not themed the same way in every Visual Studio version (light in 18.x, unthemed in 17.14), so system
      colours stay readable in any dialog theme and in the high-contrast themes.

      A view over the host's settings: loads when the page is shown (and again when the host reports that these settings
      changed and the page has no unsaved edits), shows "Host not ready" while Pillion Host is not Ready.
    -->
    <UserControl.Resources>
        <Style x:Key="Note" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
        </Style>
        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,12,0,2" />
        </Style>
        <Style x:Key="Warning" TargetType="TextBlock" BasedOn="{StaticResource Note}">
            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
            <Setter Property="FontStyle" Value="Italic" />
        </Style>
    </UserControl.Resources>

    <DockPanel Margin="4">
        <TextBlock DockPanel.Dock="Top"
                   Text="{Binding StatusMessage}"
                   FontWeight="SemiBold"
                   TextWrapping="Wrap"
                   Margin="0,0,0,6"
                   AutomationProperties.Name="{Binding StatusMessage, StringFormat='Status: {0}'}"
                   AutomationProperties.LiveSetting="Polite" />

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
            <Button Content="Save" Command="{Binding SaveCommand}" MinWidth="75" AutomationProperties.Name="Save models and routing" />
            <Button Content="Reload" Command="{Binding ReloadCommand}" MinWidth="75" Margin="6,0,0,0" AutomationProperties.Name="Reload models and routing" />
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
            <StackPanel IsEnabled="{Binding IsLoaded}">
                <TextBlock Text="Task classes" Style="{StaticResource Heading}" Margin="0,0,0,2" />
                <TextBlock Text="Which profile each kind of work uses, and whether it may be sent to a cloud model. Auto lets Pillion choose from the task, connectivity and your settings."
                           TextWrapping="Wrap" Margin="0,0,0,4" />
                <TextBlock Text="{Binding LocalOnlyNote}" Style="{StaticResource Note}" FontWeight="SemiBold" />

                <Grid Margin="0,6,0,0" Grid.IsSharedSizeScope="True">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition SharedSizeGroup="TaskName" Width="Auto" />
                            <ColumnDefinition SharedSizeGroup="TaskProfile" Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Task class" FontWeight="SemiBold" Margin="0,0,12,2" />
                        <TextBlock Grid.Column="1" Text="Profile" FontWeight="SemiBold" Margin="0,0,12,2" />
                        <TextBlock Grid.Column="2" Text="Cloud" FontWeight="SemiBold" Margin="0,0,0,2" />
                    </Grid>

                    <ItemsControl Grid.Row="1" ItemsSource="{Binding TaskRoutes}" Focusable="False" AutomationProperties.Name="Task classes">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type core:TaskRouteViewModel}">
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition SharedSizeGroup="TaskName" Width="Auto" />
                                        <ColumnDefinition SharedSizeGroup="TaskProfile" Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                    <ComboBox Grid.Row="0" Grid.Column="1"
                                              MinWidth="130"
                                              Margin="0,0,12,0"
                                              ItemsSource="{Binding ProfileChoices}"
                                              SelectedItem="{Binding SelectedProfile}"
                                              DisplayMemberPath="Label"
                                              AutomationProperties.Name="{Binding Label, StringFormat='{}{0} profile'}"
                                              AutomationProperties.HelpText="{Binding Description}" />
                                    <StackPanel Grid.Row="0" Grid.Column="2" VerticalAlignment="Center">
                                        <CheckBox Content="May use cloud models"
                                                  IsChecked="{Binding CloudSwitchOn}"
                                                  IsEnabled="{Binding CloudSwitchEnabled}"
                                                  AutomationProperties.Name="{Binding Label, StringFormat='{}{0} may use cloud models'}"
                                                  AutomationProperties.HelpText="{Binding CloudSwitchNote}">
                                            <CheckBox.Style>
                                                <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasCloudSwitch}" Value="False">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </CheckBox.Style>
                                        </CheckBox>
                                        <TextBlock Text="{Binding NoSwitchText}" Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasCloudSwitch}" Value="False">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3">
                                        <TextBlock Text="{Binding Description}" Style="{StaticResource Note}" />
                                        <TextBlock Text="{Binding CloudSwitchNote}" Style="{StaticResource Note}" />
                                        <TextBlock Text="{Binding Warning}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource Warning}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasWarning}" Value="False">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>

                <TextBlock Text="Profiles" Style="{StaticResource Heading}" />
                <TextBlock Text="Each profile maps to a model from Pillion's model catalog. Type or pick a model id to use a different one; leave it empty for the catalog default."
                           TextWrapping="Wrap" Margin="0,0,0,4" />
                <ItemsControl ItemsSource="{Binding ProfileOverrides}" Focusable="False" AutomationProperties.Name="Profile model overrides">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type core:ProfileOverrideViewModel}">
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center" />
                                <ComboBox Grid.Row="0" Grid.Column="1"
                                          IsEditable="True"
                                          Text="{Binding ModelId, UpdateSourceTrigger=PropertyChanged}"
                                          ItemsSource="{Binding Suggestions}"
                                          AutomationProperties.Name="{Binding Label, StringFormat='{}{0} model id'}"
                                          AutomationProperties.HelpText="{Binding Hint}" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Hint}" Style="{StaticResource Note}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="Reasoning" Style="{StaticResource Heading}" />
                <CheckBox Content="_Think harder by default"
                          IsChecked="{Binding ThinkHarder}"
                          AutomationProperties.Name="Think harder by default"
                          AutomationProperties.HelpText="{Binding ThinkHarderHelp}" />
                <TextBlock Text="{Binding ThinkHarderHelp}" Style="{StaticResource Note}" Margin="20,2,0,0" />

                <TextBlock Text="Local models" Style="{StaticResource Heading}" />
                <TextBlock Text="{Binding GpuTierText}" AutomationProperties.LiveSetting="Polite" />
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBlock Text="Override:" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox MinWidth="150"
                              ItemsSource="{Binding GpuTierChoices}"
                              SelectedItem="{Binding SelectedGpuTier}"
                              DisplayMemberPath="Label"
                              AutomationProperties.Name="GPU tier override"
                              AutomationProperties.HelpText="{Binding GpuTierHelp}" />
                </StackPanel>
                <TextBlock Text="{Binding GpuTierHelp}" Style="{StaticResource Note}" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
