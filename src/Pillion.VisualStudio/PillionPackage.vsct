<?xml version="1.0" encoding="utf-8"?>
<CommandTable xmlns="http://schemas.microsoft.com/VisualStudio/2005-10-18/CommandTable" xmlns:xs="http://www.w3.org/2001/XMLSchema">

  <Extern href="stdidcmd.h" />
  <Extern href="vsshlids.h" />

  <Commands package="guidPillionPackage">
    <Groups>
      <Group guid="guidPillionCommandSet" id="PillionToolsMenuGroup" priority="0x0600">
        <Parent guid="guidSHLMainMenu" id="IDM_VS_MENU_TOOLS" />
      </Group>
      <Group guid="guidPillionCommandSet" id="PillionViewOtherWindowsGroup" priority="0x0600">
        <Parent guid="guidSHLMainMenu" id="IDG_VS_WNDO_OTRWNDWS1" />
      </Group>
    </Groups>

    <Buttons>
      <Button guid="guidPillionCommandSet" id="cmdidOpenChat" priority="0x0050" type="Button">
        <Parent guid="guidPillionCommandSet" id="PillionToolsMenuGroup" />
        <Strings>
          <ButtonText>Pillion: Open Chat</ButtonText>
        </Strings>
      </Button>

      <Button guid="guidPillionCommandSet" id="cmdidViewChat" priority="0x0100" type="Button">
        <Parent guid="guidPillionCommandSet" id="PillionViewOtherWindowsGroup" />
        <Strings>
          <ButtonText>Pillion Chat</ButtonText>
        </Strings>
      </Button>

      <Button guid="guidPillionCommandSet" id="cmdidShowStatus" priority="0x0100" type="Button">
        <Parent guid="guidPillionCommandSet" id="PillionToolsMenuGroup" />
        <Strings>
          <ButtonText>Pillion: Show Status</ButtonText>
        </Strings>
      </Button>

      <Button guid="guidPillionCommandSet" id="cmdidRetryHost" priority="0x0101" type="Button">
        <Parent guid="guidPillionCommandSet" id="PillionToolsMenuGroup" />
        <Strings>
          <ButtonText>Pillion: Retry</ButtonText>
        </Strings>
      </Button>

      <Button guid="guidPillionCommandSet" id="cmdidOpenLogs" priority="0x0102" type="Button">
        <Parent guid="guidPillionCommandSet" id="PillionToolsMenuGroup" />
        <Strings>
          <ButtonText>Pillion: Open Logs</ButtonText>
        </Strings>
      </Button>

      <!--
        Ghost-text commands. Not on any menu (CommandWellOnly: they appear in Tools > Options > Keyboard); the text view's
        command filter handles them while a Pillion suggestion is displayed.
      -->
      <Button guid="guidPillionCommandSet" id="cmdidNextSuggestion" priority="0x0200" type="Button">
        <Parent guid="guidPillionCommandSet" id="PillionToolsMenuGroup" />
        <CommandFlag>CommandWellOnly</CommandFlag>
        <CommandFlag>DefaultDisabled</CommandFlag>
        <Strings>
          <ButtonText>Pillion: Next Suggestion</ButtonText>
          <CanonicalName>Pillion.NextSuggestion</CanonicalName>
          <LocCanonicalName>Pillion.NextSuggestion</LocCanonicalName>
        </Strings>
      </Button>

      <Button guid="guidPillionCommandSet" id="cmdidPreviousSuggestion" priority="0x0201" type="Button">
        <Parent guid="guidPillionCommandSet" id="PillionToolsMenuGroup" />
        <CommandFlag>CommandWellOnly</CommandFlag>
        <CommandFlag>DefaultDisabled</CommandFlag>
        <Strings>
          <ButtonText>Pillion: Previous Suggestion</ButtonText>
          <CanonicalName>Pillion.PreviousSuggestion</CanonicalName>
          <LocCanonicalName>Pillion.PreviousSuggestion</LocCanonicalName>
        </Strings>
      </Button>

      <!-- "Pillion: Suggest" asks for one suggestion at the caret now (the only way to get one when autocomplete.ordering
           is onDemand; it also works in the other modes). Handled by the text view's command filter. -->
      <Button guid="guidPillionCommandSet" id="cmdidSuggest" priority="0x0202" type="Button">
        <Parent guid="guidPillionCommandSet" id="PillionToolsMenuGroup" />
        <CommandFlag>CommandWellOnly</CommandFlag>
        <CommandFlag>DefaultDisabled</CommandFlag>
        <Strings>
          <ButtonText>Pillion: Suggest</ButtonText>
          <CanonicalName>Pillion.Suggest</CanonicalName>
          <LocCanonicalName>Pillion.Suggest</LocCanonicalName>
        </Strings>
      </Button>
    </Buttons>
  </Commands>

  <!--
    Design doc section 5, "Commands and default shortcuts": Open Pillion Chat is the prefix chord, then C. The prefix is
    provisional (Ctrl+Alt+Shift+P) until the shortcut audit confirms it.
  -->
  <KeyBindings>
    <KeyBinding guid="guidPillionCommandSet" id="cmdidOpenChat" editor="guidVSStd97" key1="P" mod1="Control Alt Shift" key2="C" />
    <!-- Next and previous suggestion: Alt+] and Alt+[ in the text editor (design section 5). Word accept (Ctrl+Right) is
         Edit.WordNext, taken by the text view's command filter only while a Pillion suggestion is displayed. -->
    <KeyBinding guid="guidPillionCommandSet" id="cmdidNextSuggestion" editor="guidTextEditor" key1="VK_OEM_6" mod1="Alt" />
    <KeyBinding guid="guidPillionCommandSet" id="cmdidPreviousSuggestion" editor="guidTextEditor" key1="VK_OEM_4" mod1="Alt" />
    <!-- Suggest: the prefix chord, then S (Alt+\ is Edit.GoToMember in Visual Studio 2026's default scheme). -->
    <KeyBinding guid="guidPillionCommandSet" id="cmdidSuggest" editor="guidVSStd97" key1="P" mod1="Control Alt Shift" key2="S" />
  </KeyBindings>

  <Symbols>
    <!-- Must match PackageGuids and PackageIds in PackageIds.cs. -->
    <GuidSymbol name="guidPillionPackage" value="{992e3a80-c52f-4dcd-b4d9-5c78dc352352}" />

    <GuidSymbol name="guidPillionCommandSet" value="{444aebc2-1c36-43a9-ab09-2c2d4e04a11d}">
      <IDSymbol name="PillionToolsMenuGroup" value="0x1020" />
      <IDSymbol name="cmdidShowStatus" value="0x0100" />
      <IDSymbol name="cmdidRetryHost" value="0x0101" />
      <IDSymbol name="cmdidOpenLogs" value="0x0102" />
      <IDSymbol name="cmdidOpenChat" value="0x0103" />
      <IDSymbol name="cmdidViewChat" value="0x0104" />
      <IDSymbol name="PillionViewOtherWindowsGroup" value="0x1021" />
      <IDSymbol name="cmdidNextSuggestion" value="0x0105" />
      <IDSymbol name="cmdidPreviousSuggestion" value="0x0106" />
      <IDSymbol name="cmdidSuggest" value="0x0310" />
    </GuidSymbol>

    <!-- The Text Editor key-binding scope (GUID_TextEditorFactory). -->
    <GuidSymbol name="guidTextEditor" value="{8B382828-6202-11d1-8870-0000F87579D2}" />
  </Symbols>

</CommandTable>
