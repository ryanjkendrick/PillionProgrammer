<?xml version="1.0" encoding="utf-8"?>
<!--
  Self-contained win-x64 publish of Pillion Host.
  Usage: dotnet publish src/Pillion.Host/Pillion.Host.csproj -p:PublishProfile=win-x64

  Trimming (work item 3.3, design document sections 13 and 16): the framework is trimmed in partial mode, so only the
  assemblies that opt in (IsTrimmable: the .NET runtime and framework, Microsoft.Extensions.*) lose unused members; every
  other assembly is copied whole, and the ones the host reaches by reflection or late binding (Roslyn, ONNX Runtime,
  SQLite, MessagePack, StreamJsonRpc, LibGit2Sharp, tree-sitter and the contracts) are rooted besides, in
  Pillion.Host.csproj. ILLink warnings are errors. PillionHostTrim=false publishes untrimmed (the fallback the plan names).
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishDir>$(MSBuildProjectDirectory)\bin\publish\win-x64\</PublishDir>

    <PillionHostTrim Condition="'$(PillionHostTrim)' == ''">true</PillionHostTrim>
    <PublishTrimmed>$(PillionHostTrim)</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <ILLinkTreatWarningsAsErrors>true</ILLinkTreatWarningsAsErrors>
    <!-- One line per warning rather than one per assembly, so a failure names the member. -->
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
  </PropertyGroup>
</Project>
