<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Pillion Host: the out-of-process .NET 10 server that the VSIX launches and talks to over a named pipe.
    Shipped self-contained (see Properties/PublishProfiles/win-x64.pubxml) so users need no .NET runtime installed.
    See README.md for the launch protocol and how to register RPC targets.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Pillion.Host</RootNamespace>
    <AssemblyName>Pillion.Host</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="StreamJsonRpc" />
    <!-- Direct reference so the host deserialises pipe traffic with the patched MessagePack pinned centrally. -->
    <PackageReference Include="MessagePack" />
    <!-- Roslyn's C# and VB parsers, for syntax validation of inline edits (no compilation; see Directory.Packages.props). -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="Microsoft.CodeAnalysis.VisualBasic" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Pillion.Contracts\Pillion.Contracts.csproj" />
    <ProjectReference Include="..\Pillion.Common\Pillion.Common.csproj" />
    <ProjectReference Include="..\Pillion.ModelGateway\Pillion.ModelGateway.csproj" />
    <ProjectReference Include="..\Pillion.LocalStore\Pillion.LocalStore.csproj" />
    <ProjectReference Include="..\Pillion.Indexing\Pillion.Indexing.csproj" />
    <ProjectReference Include="..\Pillion.ContextEngine\Pillion.ContextEngine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Pillion.Host.Tests" />
  </ItemGroup>

</Project>
