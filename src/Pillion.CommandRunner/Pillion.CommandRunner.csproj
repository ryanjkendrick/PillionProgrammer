<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Command Runner (work item 3.11, design sections 8 and 19): shell commands under a Windows pseudo-console (ConPTY) in a
    Job Object per session, a VT parser into a bounded screen buffer with scrollback, the model's redacted and truncated view
    of the output, background processes with port and HTTP readiness, and the Developer PowerShell environment of a Visual
    Studio installation. No Visual Studio dependency and no third-party package: ConPTY and Job Objects are Windows APIs
    called through LibraryImport. Pillion Host references it behind features.commandRunner. See README.md.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Pillion.CommandRunner</RootNamespace>
    <!-- Required by the LibraryImport source generator used for the ConPTY, process and Job Object P/Invokes. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <!-- The secret scanner (the model's view is redacted) and the feature flags. -->
    <ProjectReference Include="..\Pillion.Common\Pillion.Common.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Pillion.CommandRunner.Tests" />
  </ItemGroup>

</Project>
