{
  "version": 1,
  "comment": "The model catalog (design section 6): data, not code. 'profiles' maps each profile to a default model id per provider kind; routing.profiles in settings overrides it. 'families' lists capability descriptors for known model families, matched in order against the model id (case-insensitive, '*' is a wildcard); the last entry must be the '*' default. Providers that report capabilities themselves (Ollama's /api/show) override the chat, fim, vision, tools and embeddings flags and the context window.",
  "profiles": {
    "ollama": {
      "LocalFast": "qwen2.5-coder:1.5b",
      "LocalStrong": "qwen2.5-coder:14b"
    },
    "openai-compatible": {}
  },
  "families": [
    {
      "match": "qwen2.5-coder:1.5b*",
      "contextWindow": 32768,
      "maxOutputTokens": 4096,
      "chat": true,
      "fim": true,
      "toolCalling": "none"
    },
    {
      "match": "qwen2.5-coder:7b*",
      "contextWindow": 32768,
      "maxOutputTokens": 8192,
      "chat": true,
      "fim": true,
      "toolCalling": "native"
    },
    {
