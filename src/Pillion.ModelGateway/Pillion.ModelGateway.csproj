<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The Model Gateway: every model provider behind one interface used by Pillion Host. Routing by task class, profile,
    policy, connectivity, capability and cost; resilience (circuit breaker, concurrency, timeouts, retries); redaction
    at the model boundary; the autocomplete cache and the Outbound log. See README.md.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Pillion.ModelGateway</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.ML.Tokenizers" />
    <PackageReference Include="Microsoft.ML.Tokenizers.Data.O200kBase" />
    <PackageReference Include="Microsoft.ML.Tokenizers.Data.Cl100kBase" />
    <!-- Lifts the data packages' transitive Microsoft.Bcl.Memory to a patched version (see Directory.Packages.props). -->
    <PackageReference Include="Microsoft.Bcl.Memory" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Pillion.Contracts\Pillion.Contracts.csproj" />
    <ProjectReference Include="..\Pillion.Common\Pillion.Common.csproj" />
  </ItemGroup>

  <!-- Data, not code: the model catalog, the prompt templates and the token-counting families ship inside the assembly. -->
  <ItemGroup>
    <EmbeddedResource Include="Catalog\catalog.json" LogicalName="Pillion.ModelGateway.catalog.json" />
    <EmbeddedResource Include="Templates\*.json" LogicalName="Pillion.ModelGateway.Templates.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Tokens\*.json" LogicalName="Pillion.ModelGateway.Tokens.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Pillion.ModelGateway.Tests" />
    <InternalsVisibleTo Include="Pillion.Host.Tests" />
  </ItemGroup>

</Project>
