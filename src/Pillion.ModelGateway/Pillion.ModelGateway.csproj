<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The Model Gateway: every model provider behind one interface used by Pillion Host. Routing by task class, profile,
    policy, connectivity, capability and cost; resilience (circuit breaker, concurrency, timeouts, retries); redaction
    at the model boundary; the autocomplete cache and the Outbound log. See README.md.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Pillion.ModelGateway</RootNamespace>
    <!-- directml (default): ONNX Runtime with the CPU and DirectML execution providers; cpu: the CPU-only package. See Directory.Packages.props. -->
    <PillionOnnxRuntimeFlavor Condition="'$(PillionOnnxRuntimeFlavor)' == ''">directml</PillionOnnxRuntimeFlavor>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.ML.Tokenizers" />
    <PackageReference Include="Microsoft.ML.Tokenizers.Data.O200kBase" />
    <PackageReference Include="Microsoft.ML.Tokenizers.Data.Cl100kBase" />
    <!-- Lifts the data packages' transitive Microsoft.Bcl.Memory to a patched version (see Directory.Packages.props). -->
    <PackageReference Include="Microsoft.Bcl.Memory" />
  </ItemGroup>

  <!--
    ONNX Runtime for the bundled embedding model (work item 2.7). The native onnxruntime.dll flows to the host and the tests
    through the package's runtimes\win-x64\native assets. DirectML.dll does not: Microsoft.AI.DirectML copies it only from
    its build targets, only for an x64 PlatformTarget and only into the project that references it, together with a debug
    layer that must not ship. So the package's own copy is switched off and DirectML.dll is added here as content, which
    reaches the output of every referencing project and the host's publish folder.
  -->
  <PropertyGroup Condition="'$(PillionOnnxRuntimeFlavor)' == 'directml'">
    <Microsoft_AI_DirectML_SkipLibraryCopy>true</Microsoft_AI_DirectML_SkipLibraryCopy>
    <Microsoft_AI_DirectML_SkipDebugLayerCopy>true</Microsoft_AI_DirectML_SkipDebugLayerCopy>
  </PropertyGroup>
  <ItemGroup Condition="'$(PillionOnnxRuntimeFlavor)' == 'directml'">
    <PackageReference Include="Microsoft.ML.OnnxRuntime.DirectML" />
    <PackageReference Include="Microsoft.AI.DirectML" GeneratePathProperty="true" />
    <Content Include="$(PkgMicrosoft_AI_DirectML)\bin\x64-win\DirectML.dll"
             Condition="'$(PkgMicrosoft_AI_DirectML)' != ''"
             Link="DirectML.dll"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest"
             Visible="false" />
  </ItemGroup>
  <ItemGroup Condition="'$(PillionOnnxRuntimeFlavor)' == 'cpu'">
    <PackageReference Include="Microsoft.ML.OnnxRuntime" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Pillion.Contracts\Pillion.Contracts.csproj" />
    <ProjectReference Include="..\Pillion.Common\Pillion.Common.csproj" />
  </ItemGroup>

  <!--
    Data, not code: the model catalog, the prompt templates, the token-counting families and the model manifest ship inside
    the assembly. The manifest compiled in here is the one the host trusts at run time (it is covered by the assembly's
    signature); build\BundledModels.targets reads the same file to download the bundled model.
  -->
  <ItemGroup>
    <EmbeddedResource Include="Catalog\catalog.json" LogicalName="Pillion.ModelGateway.catalog.json" />
    <EmbeddedResource Include="Templates\*.json" LogicalName="Pillion.ModelGateway.Templates.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Tokens\*.json" LogicalName="Pillion.ModelGateway.Tokens.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Models\models.manifest.json" LogicalName="Pillion.ModelGateway.models.manifest.json" />
  </ItemGroup>

  <!-- The MSBuild inline tasks are compiled by MSBuild, not into this assembly. -->
  <ItemGroup>
    <Compile Remove="build\**" />
    <None Include="build\**" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Pillion.ModelGateway.Tests" />
    <InternalsVisibleTo Include="Pillion.Host.Tests" />
  </ItemGroup>

  <Import Project="build\BundledModels.targets" />

</Project>
