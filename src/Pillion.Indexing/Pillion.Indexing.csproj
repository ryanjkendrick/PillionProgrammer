<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Repository discovery, hashing and index ownership (work item 2.3, design sections 7 and 10): which files of a repository
    are indexed and why the others are not, an xxHash64 per file, the files table of index.db, the index identity and its
    folder, and the writer.lock election between hosts. The index database is a Local Store database
    (Pillion.LocalStore); chunkers, embeddings and the pipeline arrive in later work items. See README.md.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Pillion.Indexing</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.IO.Hashing" />
    <PackageReference Include="Microsoft.Data.Sqlite.Core" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Pillion.Common\Pillion.Common.csproj" />
    <ProjectReference Include="..\Pillion.LocalStore\Pillion.LocalStore.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Pillion.Indexing.Tests" />
  </ItemGroup>

</Project>
