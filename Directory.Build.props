<Project>
  <!--
    Shared settings for every project in the repository.
    ImplicitUsings is enabled for net10.0 projects only; because TargetFramework is not yet known
    when this file is evaluated, that switch lives in Directory.Build.targets.
  -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>

    <Company>Pillion Programmer contributors</Company>
    <Authors>Pillion Programmer contributors</Authors>
    <Product>Pillion Programmer</Product>
    <Copyright>Copyright (c) 2026 Ryan Kendrick</Copyright>
    <VersionPrefix>0.1.0</VersionPrefix>

    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- Also required for IDE0005 (unnecessary usings) to be reported during build. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(CI)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>
</Project>
