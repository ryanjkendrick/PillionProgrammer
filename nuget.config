<?xml version="1.0" encoding="utf-8"?>
<!--
  Package sources for the repository. Everything comes from nuget.org except the Visual Studio integration testing
  framework (Microsoft.VisualStudio.Extensibility.Testing.*), which Microsoft publishes only to the public, anonymous
  Azure Artifacts feed "vssdk" (it is not on nuget.org). Package source mapping pins each package to one source, so no
  other package can be resolved from the second feed.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="vssdk" value="https://pkgs.dev.azure.com/azure-public/vside/_packaging/vssdk/nuget/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="vssdk">
      <package pattern="Microsoft.VisualStudio.Extensibility.Testing.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
