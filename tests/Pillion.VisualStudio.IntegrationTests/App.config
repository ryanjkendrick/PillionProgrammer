<?xml version="1.0" encoding="utf-8"?>
<!--
  For the test runner process only (devenv.exe has its own configuration). The integration testing framework is built
  against Microsoft.VisualStudio.Interop 18.0; the types it uses (EnvDTE, OLE and Shell interop) are the same in the
  17.0 assembly that the 17.14 SDK puts next to the tests, so the runner binds 18.0 to it.
-->
<configuration>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="Microsoft.VisualStudio.Interop" publicKeyToken="b03f5f7f11d50a3a" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-18.0.0.0" newVersion="17.0.0.0" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
</configuration>
