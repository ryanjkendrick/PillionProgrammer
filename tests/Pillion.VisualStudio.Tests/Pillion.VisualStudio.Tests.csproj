<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Tests for Pillion.VisualStudio.Core (the supervisor, launcher, RPC client and logger). net48, like the code under
    test, which runs inside devenv.exe. StreamJsonRpc and Microsoft.VisualStudio.Threading are compile-only in Core
    (Visual Studio supplies them); here they are referenced normally so the tests have them at run time.
  -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="StreamJsonRpc" />
    <PackageReference Include="MessagePack" />
    <PackageReference Include="Microsoft.VisualStudio.Threading" />
    <!-- Markdig (through Core) needs System.Memory 4.6.3; the RPC packages bring 4.6.0. -->
    <PackageReference Include="System.Memory" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Pillion.VisualStudio.Core\Pillion.VisualStudio.Core.csproj" />
    <!-- Build-order only: the real-process tests launch the fake host from its own output folder. -->
    <ProjectReference Include="..\Pillion.FakeHost\Pillion.FakeHost.csproj" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" GlobalPropertiesToRemove="TargetFramework" />
  </ItemGroup>

  <!--
    The chat window's Markdown renderer lives in the VSIX, which dotnet cannot build, but these files have no Visual Studio
    dependency: they are compiled into this assembly too so the block-to-element mapping, the incremental updates and the
    virtualised transcript can be tested on a WPF thread.
  -->
  <ItemGroup>
    <Compile Include="..\..\src\Pillion.VisualStudio\ToolWindows\Markdown\MarkdownRenderContext.cs" Link="Linked\MarkdownRenderContext.cs" />
    <Compile Include="..\..\src\Pillion.VisualStudio\ToolWindows\Markdown\MarkdownBlockRenderer.cs" Link="Linked\MarkdownBlockRenderer.cs" />
    <Compile Include="..\..\src\Pillion.VisualStudio\ToolWindows\Markdown\MarkdownMessageView.cs" Link="Linked\MarkdownMessageView.cs" />
    <!-- The bounded search for the status bar's panel (the indexing indicator, work item 2.15): plain WPF too. -->
    <Compile Include="..\..\src\Pillion.VisualStudio\Statusbar\StatusBarPanelFinder.cs" Link="Linked\StatusBarPanelFinder.cs" />
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="WindowsBase" />
    <Reference Include="System.Xaml" />
  </ItemGroup>

  <!--
    The host kill integration test's verdict and UI-thread attribution (HostKillVerdictTests): plain WPF and BCL code
    from the integration tests, which only run inside Visual Studio.
  -->
  <ItemGroup>
    <Compile Include="..\Pillion.VisualStudio.IntegrationTests\DispatcherProbe.cs" Link="Linked\DispatcherProbe.cs" />
    <Compile Include="..\Pillion.VisualStudio.IntegrationTests\UiThreadMonitor.cs" Link="Linked\UiThreadMonitor.cs" />
    <Compile Include="..\Pillion.VisualStudio.IntegrationTests\Polyfills.cs" Link="Linked\Polyfills.cs" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>FakeHostPath</_Parameter1>
      <_Parameter2>$(MSBuildThisFileDirectory)..\Pillion.FakeHost\bin\$(Configuration)\net10.0\Pillion.FakeHost.exe</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
