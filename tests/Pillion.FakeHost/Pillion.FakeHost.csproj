<Project Sdk="Microsoft.NET.Sdk">

  <!--
    A stand-in for Pillion Host used by tests/Pillion.VisualStudio.Tests. It speaks the real launch protocol (token over
    an inherited anonymous pipe, CurrentUserOnly named pipe, StreamJsonRpc with LengthHeaderMessageHandler and the
    MessagePack formatter, handshake, hostStateChanged), plus canned IModelService and in-memory ISettingsService
    targets, so the VSIX supervisor, chat window and Options pages can be tested against a real process without the
    Model Gateway. It can also stand in for Pillion.Host.exe in the Experimental Instance for manual checks.
    Behaviour is selected with the PILLION_FAKEHOST_MODE environment variable (see Program.cs).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Pillion.FakeHost</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>false</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="StreamJsonRpc" />
    <PackageReference Include="MessagePack" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Pillion.Contracts\Pillion.Contracts.csproj" />
  </ItemGroup>

</Project>
