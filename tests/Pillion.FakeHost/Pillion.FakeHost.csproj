<Project Sdk="Microsoft.NET.Sdk">

  <!--
    A stand-in for Pillion Host used by tests/Pillion.VisualStudio.Tests. It speaks the real launch protocol (token over
    an inherited anonymous pipe, CurrentUserOnly named pipe, StreamJsonRpc with LengthHeaderMessageHandler and the
    MessagePack formatter, handshake, hostStateChanged) without any host features, so the VSIX supervisor can be tested
    against a real process before Pillion Host's RPC server exists. Behaviour is selected with the
    PILLION_FAKEHOST_MODE environment variable (see Program.cs).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Pillion.FakeHost</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>false</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="StreamJsonRpc" />
    <PackageReference Include="MessagePack" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Pillion.Contracts\Pillion.Contracts.csproj" />
  </ItemGroup>

</Project>
